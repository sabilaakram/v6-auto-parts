{% comment %}
  Compare page (up to 4 products). Products are added with the Compare button on the
  product page (assets/v6-wishlist.js). Each product's data is loaded from
  /products/<handle>?view=v6data, and the "custom.specs" metafield lines
  ("Label: value") become extra comparison rows.
{% endcomment %}

<style>
  .v6-cmp-{{ section.id }} {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .v6-cmp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e5e5;
  }
  .v6-cmp__title { margin: 0; }
  .v6-cmp__sub { margin: 6px 0 0; color: #666; font-size: 1.4rem; }
  .v6-cmp__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .v6-cmp__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid #d7d7d7;
    background: #fff;
    color: #222;
    font-size: 1.35rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .v6-cmp__btn:hover { border-color: #a50000; color: #a50000; }
  .v6-cmp__btn--primary { background: #a50000; border-color: #a50000; color: #fff; width: 100%; }
  .v6-cmp__btn--primary:hover { background: #8a0000; color: #fff; }
  .v6-cmp__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid #e5e5e5; border-radius: 12px; }
  .v6-cmp__table { width: 100%; border-collapse: collapse; table-layout: fixed; min-width: 640px; font-size: 1.4rem; }
  .v6-cmp__table th, .v6-cmp__table td { padding: 14px 16px; border-bottom: 1px solid #eee; vertical-align: top; text-align: left; }
  .v6-cmp__table tr:last-child th, .v6-cmp__table tr:last-child td { border-bottom: 0; }
  .v6-cmp__table th { width: 170px; background: #f7f7f7; color: #444; font-weight: 600; position: sticky; left: 0; z-index: 1; }
  .v6-cmp__table td + td { border-left: 1px solid #eee; }
  .v6-cmp__prod { position: relative; }
  .v6-cmp__img { display: block; width: 100%; max-width: 200px; aspect-ratio: 1; background: #fafafa; border-radius: 8px; overflow: hidden; margin-bottom: 10px; }
  .v6-cmp__img img { width: 100%; height: 100%; object-fit: contain; }
  .v6-cmp__name { color: #111; font-weight: 600; text-decoration: none; line-height: 1.35; display: block; }
  .v6-cmp__name:hover { color: #a50000; }
  .v6-cmp__remove {
    position: absolute; top: -4px; right: -4px; width: 30px; height: 30px; border-radius: 50%;
    border: 1px solid #ddd; background: #fff; color: #555; font-size: 18px; line-height: 1; cursor: pointer;
  }
  .v6-cmp__remove:hover { border-color: #a50000; color: #a50000; }
  .v6-cmp__price { font-weight: 700; color: #a50000; font-size: 1.6rem; }
  .v6-cmp__was { color: #888; text-decoration: line-through; font-size: 1.3rem; margin-left: 6px; font-weight: 400; }
  .v6-cmp__stock--in { color: #1a7f37; font-weight: 600; }
  .v6-cmp__stock--out { color: #b42318; font-weight: 600; }
  .v6-cmp__empty { text-align: center; padding: 60px 16px; }
  .v6-cmp__empty p { color: #666; margin: 8px 0 20px; }
  .v6-cmp__empty .v6-cmp__btn--primary { width: auto; }
  .v6-cmp__loading { padding: 40px 0; text-align: center; color: #777; }
  .v6-cmp__muted { color: #aaa; }
</style>

<div class="v6-cmp-{{ section.id }}" data-v6-compare data-cart-add="{{ routes.cart_add_url }}">
  <div class="v6-cmp__head">
    <div>
      <h1 class="v6-cmp__title h2">{{ section.settings.heading | escape }}</h1>
      <p class="v6-cmp__sub">Compare up to 4 products side by side &middot; <span data-compare-count>0</span> selected</p>
    </div>
    <div class="v6-cmp__actions">
      <a class="v6-cmp__btn" href="{{ settings.v6_wishlist_url | default: '/pages/wishlist' }}">Wishlist (<span data-wishlist-count>0</span>)</a>
      <button type="button" class="v6-cmp__btn" data-cmp-clear hidden>Clear all</button>
    </div>
  </div>

  <div class="v6-cmp__loading" data-cmp-loading>Loading products…</div>
  <div class="v6-cmp__scroll" data-cmp-wrap hidden><table class="v6-cmp__table" data-cmp-table></table></div>

  <div class="v6-cmp__empty" data-cmp-empty hidden>
    <h2 class="h3">No products to compare yet</h2>
    <p>Open any product and tap <strong>Compare</strong> to add it here.</p>
    <a class="v6-cmp__btn v6-cmp__btn--primary" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Browse products</a>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-v6-compare]');
    if (!root) return;
    var table = root.querySelector('[data-cmp-table]');
    var wrap = root.querySelector('[data-cmp-wrap]');
    var empty = root.querySelector('[data-cmp-empty]');
    var loading = root.querySelector('[data-cmp-loading]');
    var clearBtn = root.querySelector('[data-cmp-clear]');
    var cartAdd = root.getAttribute('data-cart-add');
    var base = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
    var products = [];

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function parseSpecs(text) {
      var out = { rows: {}, extra: [] };
      String(text || '').split(/\r?\n/).forEach(function (line) {
        line = line.trim();
        if (!line) return;
        var i = line.indexOf(':');
        if (i > 0) out.rows[line.slice(0, i).trim()] = line.slice(i + 1).trim();
        else out.extra.push(line);
      });
      return out;
    }

    function render() {
      loading.hidden = true;
      if (!products.length) {
        wrap.hidden = true;
        empty.hidden = false;
        clearBtn.hidden = true;
        return;
      }
      empty.hidden = true;
      wrap.hidden = false;
      clearBtn.hidden = false;

      var specLabels = [];
      products.forEach(function (p) {
        p._specs = parseSpecs(p.specs);
        Object.keys(p._specs.rows).forEach(function (k) {
          if (specLabels.indexOf(k) === -1) specLabels.push(k);
        });
      });
      var hasExtra = products.some(function (p) { return p._specs.extra.length; });

      function row(label, cell) {
        return '<tr><th scope="row">' + esc(label) + '</th>' + products.map(function (p) {
          return '<td>' + cell(p) + '</td>';
        }).join('') + '</tr>';
      }
      function text(v) { return v ? esc(v) : '<span class="v6-cmp__muted">&ndash;</span>'; }

      var html = '';
      html += row('Product', function (p) {
        return '<div class="v6-cmp__prod">' +
          '<button type="button" class="v6-cmp__remove" data-cmp-remove="' + esc(p.id) + '" aria-label="Remove ' + esc(p.title) + '">&times;</button>' +
          '<a class="v6-cmp__img" href="' + esc(p.url) + '">' + (p.image ? '<img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" loading="lazy">' : '') + '</a>' +
          '<a class="v6-cmp__name" href="' + esc(p.url) + '">' + esc(p.title) + '</a></div>';
      });
      html += row('Price', function (p) {
        return '<span class="v6-cmp__price">' + esc(p.price) + '</span>' + (p.compare_at ? '<span class="v6-cmp__was">' + esc(p.compare_at) + '</span>' : '');
      });
      html += row('Availability', function (p) {
        return p.available ? '<span class="v6-cmp__stock--in">In stock</span>' : '<span class="v6-cmp__stock--out">Sold out</span>';
      });
      html += row('Brand', function (p) { return text(p.vendor); });
      html += row('Category', function (p) { return text(p.type); });
      html += row('SKU / Ref', function (p) { return text(p.sku); });
      specLabels.forEach(function (label) {
        html += row(label, function (p) { return text(p._specs.rows[label]); });
      });
      if (hasExtra) {
        html += row('Other details', function (p) {
          return p._specs.extra.length ? p._specs.extra.map(esc).join('<br>') : text('');
        });
      }
      html += row('', function (p) {
        if (!p.available) return '<a class="v6-cmp__btn" href="' + esc(p.url) + '">View product</a>';
        if (!p.single_variant) return '<a class="v6-cmp__btn v6-cmp__btn--primary" href="' + esc(p.url) + '">Choose options</a>';
        return '<form method="post" action="' + esc(cartAdd) + '">' +
          '<input type="hidden" name="id" value="' + esc(p.variant_id) + '">' +
          '<input type="hidden" name="quantity" value="1">' +
          '<button type="submit" class="v6-cmp__btn v6-cmp__btn--primary">Add to cart</button></form>';
      });
      table.innerHTML = '<tbody>' + html + '</tbody>';
    }

    function load() {
      var L = window.V6Lists;
      var ids = L.ids('compare');
      var map = L.handles('compare');
      var withHandle = ids.filter(function (id) { return map[id]; });
      if (!withHandle.length) {
        products = [];
        render();
        return;
      }
      loading.hidden = false;
      Promise.all(
        withHandle.map(function (id) {
          return fetch(base + 'products/' + encodeURIComponent(map[id]) + '?view=v6data', { credentials: 'same-origin' })
            .then(function (r) {
              if (r.status === 404) { L.remove('compare', id); return null; }
              return r.ok ? r.text() : null;
            })
            .then(function (t) {
              if (!t) return null;
              try { return JSON.parse(t); } catch (e) { return null; }
            })
            .catch(function () { return null; });
        })
      ).then(function (list) {
        products = list.filter(Boolean);
        render();
      });
    }

    root.addEventListener('click', function (e) {
      var rm = e.target.closest('[data-cmp-remove]');
      if (!rm) return;
      var id = rm.getAttribute('data-cmp-remove');
      window.V6Lists.remove('compare', id);
      products = products.filter(function (p) { return String(p.id) !== id; });
      render();
    });

    clearBtn.addEventListener('click', function () {
      window.V6Lists.clear('compare');
      products = [];
      render();
    });

    function start() {
      if (window.V6Lists) load();
      else setTimeout(start, 50);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>

{% schema %}
{
  "name": "V6 Compare",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare Products" },
    { "type": "url", "id": "shop_link", "label": "Browse products link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "V6 Compare" }]
}
{% endschema %}
