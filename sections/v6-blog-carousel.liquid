{% comment %}
  Homepage blog carousel. With one article it shows a wide featured card;
  with two or more it becomes a swipeable carousel with arrow buttons.
  Cards reuse snippets/v6-article-card.liquid and assets/v6-blog.css.
{% endcomment %}

{{ 'v6-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source_blog = section.settings.blog | default: blogs.blog
  assign sid = section.id | replace: '_', '' | downcase
  assign count = 0
  if source_blog
    assign count = source_blog.articles_count
    if count > section.settings.limit
      assign count = section.settings.limit
    endif
  endif
-%}

{% style %}
  .v6-bc-{{ sid }} {
    padding: {{ section.settings.padding_top_mobile }}px 0 {{ section.settings.padding_bottom_mobile }}px;
    background: {{ section.settings.background }};
  }

  @media screen and (min-width: 750px) {
    .v6-bc-{{ sid }} {
      padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{%- if count > 0 -%}
  <div
    class="v6-blog v6-bc v6-bc-{{ sid }}"
    style="--v6-accent: {{ section.settings.accent_color }}; --v6-dark: {{ section.settings.dark_color }};"
  >
    <div class="v6-wrap">
      <div class="v6-bc__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="v6-bc__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="v6-bc__title">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="v6-bc__actions">
          {%- if count > 1 -%}
            <div class="v6-bc__arrows" data-v6-arrows hidden>
              <button type="button" class="v6-bc__arrow" data-v6-prev aria-label="Previous articles">
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
              </button>
              <button type="button" class="v6-bc__arrow" data-v6-next aria-label="Next articles">
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          {%- endif -%}
          <a href="{{ source_blog.url }}" class="v6-bc__all">
            {{- section.settings.view_all_label | escape }} &rarr;</a
          >
        </div>
      </div>

      {%- if count == 1 -%}
        {%- assign a = source_blog.articles.first -%}
        <article class="v6-card v6-card--featured v6-bc__single">
          <a href="{{ a.url }}" class="v6-card__media" tabindex="-1" aria-hidden="true">
            {%- if a.image -%}
              {{
                a.image
                | image_url: width: 1280
                | image_tag:
                  widths: '360, 540, 720, 960, 1280',
                  sizes: '(min-width: 990px) 640px, 100vw',
                  loading: 'lazy',
                  alt: a.image.alt,
                  class: 'v6-card__img'
              }}
            {%- else -%}
              <span class="v6-card__placeholder">{{ 'blog-apparel-1' | placeholder_svg_tag: 'v6-card__img' }}</span>
            {%- endif -%}
          </a>
          <div class="v6-card__body">
            <span class="v6-card__tag">Latest article</span>
            <h3 class="v6-card__title"><a href="{{ a.url }}">{{ a.title | escape }}</a></h3>
            <div class="v6-card__meta">
              <span>{{ a.published_at | time_tag: '%-d %B %Y' }}</span>
              <span>{{ a.published_at | time_tag: '%H:%M' }}</span>
            </div>
            <a href="{{ a.url }}" class="v6-btn v6-btn--accent v6-bc__read">
              Read article
              <span class="visually-hidden">: {{ a.title | escape }}</span>
            </a>
          </div>
        </article>
      {%- else -%}
        <ul class="v6-bc__track" role="list" data-v6-track tabindex="0" aria-label="{{ section.settings.heading | escape }}">
          {%- for a in source_blog.articles limit: section.settings.limit -%}
            <li class="v6-bc__slide">
              {% render 'v6-article-card', article: a, minimal: true %}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if count > 1 -%}
    <script>
      (function () {
        var root = document.querySelector('.v6-bc-{{ sid }}');
        if (!root) return;
        var track = root.querySelector('[data-v6-track]');
        var arrows = root.querySelector('[data-v6-arrows]');
        var prev = root.querySelector('[data-v6-prev]');
        var next = root.querySelector('[data-v6-next]');
        if (!track || !arrows) return;

        function step() {
          var slide = track.querySelector('.v6-bc__slide');
          var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          return slide ? slide.getBoundingClientRect().width + gap : track.clientWidth;
        }

        function update() {
          var max = track.scrollWidth - track.clientWidth;
          arrows.hidden = max <= 2;
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= max - 2;
        }

        prev.addEventListener('click', function () {
          track.scrollBy({ left: -step(), behavior: 'smooth' });
        });
        next.addEventListener('click', function () {
          track.scrollBy({ left: step(), behavior: 'smooth' });
        });
        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "V6 blog carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Defaults to the \"Blog\" blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Maximum articles",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "Guides & advice"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From the blog"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all articles"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#a50000"
    },
    {
      "type": "color",
      "id": "dark_color",
      "label": "Dark colour",
      "default": "#242833"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "V6 blog carousel"
    }
  ]
}
{% endschema %}
