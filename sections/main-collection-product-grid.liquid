{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ai-collection-{{ section.id }} {
    --ai-font-family: {{ section.settings.body_font.family }}, {{ section.settings.body_font.fallback_families }};
    --ai-font-weight: {{ section.settings.body_font_weight }};
    --ai-font-size: {{ section.settings.body_font_size }}px;
    --ai-text-color: {{ section.settings.text_color }};
    font-family: var(--ai-font-family);
    font-weight: var(--ai-font-weight);
    font-size: var(--ai-font-size);
    color: var(--ai-text-color);
  }

  .ai-collection-{{ section.id }} select,
  .ai-collection-{{ section.id }} button,
  .ai-collection-{{ section.id }} input,
  .ai-collection-{{ section.id }} label {
    font-family: inherit;
  }

  .ai-collection-{{ section.id }} .ai-collection__container {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding-left: 80px;
    padding-right: 80px;
    box-sizing: border-box;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-{{ section.id }} .ai-collection__container {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-{{ section.id }} .ai-collection__container {
      padding-left: 20px;
      padding-right: 20px;
    }
  }

  .ai-collection-{{ section.id }} .ai-collection__categories {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid #eee;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .ai-collection-{{ section.id }} .ai-collection__categories::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-{{ section.id }} .ai-collection__category-link {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border-radius: 20px;
    border: 1px solid #dcdcdc;
    color: #111;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .ai-collection-{{ section.id }} .ai-collection__category-link:hover,
  .ai-collection-{{ section.id }} .ai-collection__category-link.is-active {
    background: #a50000;
    border-color: #a50000;
    color: #fff;
  }

  .ai-collection-{{ section.id }} .ai-collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-collection-{{ section.id }} .ai-collection__toolbar .product-count {
    margin: 0;
  }

  .ai-collection-{{ section.id }} .ai-collection__toolbar-right {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .ai-collection-{{ section.id }} .ai-collection__view-toggle {
    display: flex;
    align-items: center;
    gap: 4px;
    border: 1px solid #ddd;
    border-radius: 4px;
    padding: 3px;
  }

  .ai-collection-{{ section.id }} .ai-collection__view-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    border-radius: 3px;
    cursor: pointer;
    color: #999;
    padding: 0;
  }

  .ai-collection-{{ section.id }} .ai-collection__view-button svg {
    width: 16px;
    height: 16px;
  }

  .ai-collection-{{ section.id }} .ai-collection__view-button.is-active {
    background: #a50000;
    color: #fff;
  }

  .ai-collection-{{ section.id }} .ai-collection__sidebar-heading {
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 14px 0;
    color: #111;
  }

  .ai-collection-{{ section.id }} .facets__summary {
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .ai-collection-{{ section.id }} .facet-checkbox.active .facet-checkbox__text-label {
    color: #a50000;
    font-weight: 600;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #e5e5e5;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-item {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    margin-bottom: 16px;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-item:last-child {
    margin-bottom: 0;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-image {
    flex: 0 0 auto;
    width: 60px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-title {
    font-size: 13px;
    line-height: 1.35;
    margin: 0 0 4px 0;
    color: #111;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-collection-{{ section.id }} .ai-collection__latest-price {
    font-size: 13px;
    font-weight: 600;
    color: #a50000;
  }

  .ai-collection-{{ section.id }} .facets-vertical {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    width: 100%;
  }

  .ai-collection-{{ section.id }} .facets-wrapper {
    flex: 0 0 260px !important;
    width: 260px !important;
    max-width: 260px;
    padding-right: 0 !important;
    box-sizing: border-box;
  }

  .ai-collection-{{ section.id }} .product-grid-container {
    flex: 1 1 0 !important;
    min-width: 0;
    width: auto !important;
  }

  .ai-collection-{{ section.id }} .collection,
  .ai-collection-{{ section.id }} .product-grid {
    width: 100%;
  }

  .ai-collection-{{ section.id }} .product-card__footer {
    gap: 12px;
  }

  .ai-collection-{{ section.id }} .product-card__cta {
    flex: 0 0 auto;
  }

  /*
    This theme's base .grid class is display:flex with column widths set via
    width/max-width on the .grid__item children (assets/base.css) — it is NOT
    CSS Grid, so grid-template-columns alone has no effect. The view-toggle
    states below switch the container to a real CSS grid and reset the
    flex-inherited sizing on the <li> items so the column count actually changes.
  */
  .ai-collection-{{ section.id }} .product-grid.grid--view-grid3,
  .ai-collection-{{ section.id }} .product-grid.grid--view-grid4,
  .ai-collection-{{ section.id }} .product-grid.grid--view-list {
    display: grid !important;
    column-gap: 24px;
    row-gap: 32px;
  }

  .ai-collection-{{ section.id }} .product-grid.grid--view-grid3 > .grid__item,
  .ai-collection-{{ section.id }} .product-grid.grid--view-grid4 > .grid__item,
  .ai-collection-{{ section.id }} .product-grid.grid--view-list > .grid__item {
    width: auto !important;
    max-width: none !important;
    flex-grow: 0;
    flex-shrink: 0;
  }

  .ai-collection-{{ section.id }} .product-grid.grid--view-grid3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .ai-collection-{{ section.id }} .product-grid.grid--view-grid4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .ai-collection-{{ section.id }} .product-grid.grid--view-list {
    grid-template-columns: 1fr;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-{{ section.id }} .product-grid.grid--view-grid4 {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-collection-{{ section.id }} .ai-collection__latest {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-{{ section.id }} .facets-vertical {
      flex-direction: column;
    }

    .ai-collection-{{ section.id }} .facets-wrapper {
      flex-basis: auto !important;
      width: 100% !important;
      max-width: none;
    }

    .ai-collection-{{ section.id }} .product-grid.grid--view-grid3,
    .ai-collection-{{ section.id }} .product-grid.grid--view-grid4 {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 14px;
      row-gap: 20px;
    }

    .ai-collection-{{ section.id }} .ai-collection__view-toggle {
      display: none;
    }
  }
{%- endstyle -%}

<collection-component
  class="ai-collection-{{ section.id }}"
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    <div class="ai-collection__container">
      {%- if section.settings.category_menu != blank -%}
        <nav class="ai-collection__categories" aria-label="Categories">
          {%- for link in section.settings.category_menu.links -%}
            <a
              href="{{ link.url }}"
              class="ai-collection__category-link{% if link.active %} is-active{% endif %}"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="ai-collection__container">
        <facet-filters-form class="facets facets-vertical-sort small-hide">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="ai-collection__toolbar">
              <div class="product-count-vertical light" role="status">
                <h2 class="product-count__text text-body">
                  <span id="ProductCountDesktop">
                    {%- if collection.results_count -%}
                      {{
                        'templates.search.results_with_count'
                        | t: terms: collection.terms, count: collection.results_count
                      }}
                    {%- elsif collection.products_count == collection.all_products_count -%}
                      {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                    {%- else -%}
                      {{
                        'products.facets.product_count'
                        | t: product_count: collection.products_count, count: collection.all_products_count
                      }}
                    {%- endif -%}
                  </span>
                </h2>
                {%- render 'loading-spinner' -%}
              </div>

              <div class="ai-collection__toolbar-right">
                {%- if section.settings.enable_sorting -%}
                  <div class="facet-filters sorting caption">
                    <div class="facet-filters__field">
                      <h2 class="facet-filters__label caption-large text-body">
                        <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                      </h2>
                      <div class="select">
                        {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                        <select
                          name="sort_by"
                          class="facet-filters__sort select__select caption-large"
                          id="SortBy"
                          aria-describedby="a11y-refresh-page-message"
                        >
                          {%- for option in collection.sort_options -%}
                            <option
                              value="{{ option.value | escape }}"
                              {% if option.value == sort_by %}
                                selected="selected"
                              {% endif %}
                            >
                              {{ option.name | escape }}
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="svg-wrapper">
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </span>
                      </div>
                    </div>
                  </div>
                {%- endif -%}

                <ai-grid-view-toggle class="ai-collection__view-toggle" data-default="{{ section.settings.default_grid_view }}">
                  <button type="button" class="ai-collection__view-button" data-view="grid-3" aria-label="Grid view (3 columns)">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="9.5" y="3" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="16" y="3" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="9.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="9.5" y="9.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/><rect x="16" y="9.5" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.6"/></svg>
                  </button>
                  <button type="button" class="ai-collection__view-button" data-view="grid-4" aria-label="Grid view (4 columns)">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2.5" y="2.5" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="7.7" y="2.5" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="12.9" y="2.5" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="18.1" y="2.5" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="7.7" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="7.7" y="7.7" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="12.9" y="7.7" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/><rect x="18.1" y="7.7" width="4" height="4" rx="0.8" stroke="currentColor" stroke-width="1.5"/></svg>
                  </button>
                </ai-grid-view-toggle>
              </div>
            </div>
          </form>
        </facet-filters-form>
      </div>

      <div class="facets-vertical ai-collection__container">
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: false,
              filter_type: 'vertical',
              paginate: paginate,
              exclude_labels: section.settings.hidden_filter_labels
            %}

            {%- if section.settings.show_latest_products -%}
              {%- liquid
                assign latest_source = section.settings.latest_products_collection.products | default: collection.products
                assign latest_products = latest_source | sort: 'created_at' | reverse
              -%}
              {%- if latest_products.size > 0 -%}
                <div class="ai-collection__latest">
                  <h2 class="ai-collection__sidebar-heading">Latest Products</h2>
                  {%- for latest_product in latest_products limit: section.settings.latest_products_count -%}
                    <a href="{{ latest_product.url }}" class="ai-collection__latest-item">
                      <span class="ai-collection__latest-image">
                        {%- if latest_product.featured_media -%}
                          {{ latest_product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy' }}
                        {%- endif -%}
                      </span>
                      <span>
                        <span class="ai-collection__latest-title">{{ latest_product.title }}</span>
                        <span class="ai-collection__latest-price">{{ latest_product.price | money }}</span>
                      </span>
                    </a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            {%- endif -%}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: collection.url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay gradient"></div>
              <ul
                id="product-grid"
                data-id="{{ section.id }}"
                class="
                  grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                  grid--{{ section.settings.columns_desktop }}-col-desktop
                  grid--view-{{ section.settings.default_grid_view | replace: 'grid-', 'grid' }}
                "
              >
                {% assign skip_card_product_styles = false %}
                {%- for product in collection.products -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li
                    class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    {% render 'card-product',
                      card_product: product,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      lazy_load: lazy_load,
                      skip_styles: skip_card_product_styles,
                      quick_add: true,
                      enable_quick_view: section.settings.enable_quick_view,
                      section_id: section.id,
                      product_view_context: 'collection'
                    %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</collection-component>

<script>
  (function () {
    if (customElements.get('ai-grid-view-toggle')) return;

    class AiGridViewToggle extends HTMLElement {
      connectedCallback() {
        this.buttons = this.querySelectorAll('[data-view]');
        this.storageKey = 'v6-collection-grid-view';

        let view = this.dataset.default || 'grid-3';
        try {
          view = localStorage.getItem(this.storageKey) || view;
        } catch (e) {}

        this.setView(view, false);

        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            this.setView(button.getAttribute('data-view'), true);
          });
        });

        // Dawn's facets.js replaces #product-grid wholesale on every
        // filter/sort change, so re-apply the current view after that happens.
        this.observer = new MutationObserver(() => this.reapply());
        const container = document.getElementById('ProductGridContainer');
        if (container) {
          this.observer.observe(container, { childList: true, subtree: true });
        }
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      getGrid() {
        return document.getElementById('product-grid');
      }

      reapply() {
        let view = this.dataset.default || 'grid-3';
        try {
          view = localStorage.getItem(this.storageKey) || view;
        } catch (e) {}
        this.setView(view, false);
      }

      setView(view, persist) {
        const validViews = ['grid-3', 'grid-4'];
        if (validViews.indexOf(view) === -1) view = this.dataset.default || 'grid-3';

        const grid = this.getGrid();
        if (!grid) return;
        grid.classList.remove('grid--view-grid3', 'grid--view-grid4', 'grid--view-list');
        const className = 'grid--view-' + view.replace('grid-', 'grid');
        grid.classList.add(className);

        this.buttons.forEach((button) => {
          button.classList.toggle('is-active', button.getAttribute('data-view') === view);
        });

        if (persist) {
          try {
            localStorage.setItem(this.storageKey, view);
          } catch (e) {}
        }
      }
    }

    customElements.define('ai-grid-view-toggle', AiGridViewToggle);
  })();
</script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "select",
      "id": "default_grid_view",
      "label": "Default grid style",
      "options": [
        { "value": "grid-3", "label": "Grid — 3 columns" },
        { "value": "grid-4", "label": "Grid — 4 columns" }
      ],
      "default": "grid-3"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Font",
      "default": "inter_n4",
      "info": "Applies to filters, toolbar, sidebar and product cards on this page."
