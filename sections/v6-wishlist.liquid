{% comment %}
  Wishlist page. Products are saved in the visitor's browser by assets/v6-wishlist.js
  (hearts on product cards and the product page). Each saved product is loaded as a
  normal product card via /products/<handle>?view=v6card.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- comment -%} Card styles, loaded once (the placeholder card itself stays hidden). {%- endcomment -%}
<div hidden aria-hidden="true">{% render 'card-product', card_product: nil, enable_quick_view: false %}</div>

<style>
  .v6-wl-{{ section.id }} {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .v6-wl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e5e5e5;
  }
  .v6-wl__title { margin: 0; }
  .v6-wl__sub { margin: 6px 0 0; color: #666; font-size: 1.4rem; }
  .v6-wl__actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .v6-wl__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid #d7d7d7;
    background: #fff;
    color: #222;
    font-size: 1.35rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .v6-wl__btn:hover { border-color: #a50000; color: #a50000; }
  .v6-wl__btn--primary { background: #a50000; border-color: #a50000; color: #fff; }
  .v6-wl__btn--primary:hover { background: #8a0000; color: #fff; }
  .v6-wl__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 989px) { .v6-wl__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 749px) { .v6-wl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } }
  .v6-wl__grid > li { display: flex; }
  .v6-wl__grid > li > .product-card { width: 100%; }
  .v6-wl__empty { text-align: center; padding: 60px 16px; }
  .v6-wl__empty svg { width: 56px; height: 56px; stroke: #a50000; fill: none; stroke-width: 1.6; margin-bottom: 12px; }
  .v6-wl__empty p { color: #666; margin: 8px 0 20px; }
  .v6-wl__note { margin-top: 20px; color: #777; font-size: 1.3rem; }
  .v6-wl__loading { padding: 40px 0; text-align: center; color: #777; }
</style>

<div class="v6-wl-{{ section.id }}" data-v6-wishlist>
  <div class="v6-wl__head">
    <div>
      <h1 class="v6-wl__title h2">{{ section.settings.heading | escape }}</h1>
      <p class="v6-wl__sub"><span data-wishlist-count>0</span> saved item(s) &middot; saved on this device</p>
    </div>
    <div class="v6-wl__actions">
      <a class="v6-wl__btn" href="{{ settings.v6_compare_url | default: '/pages/compare' }}">
        Compare (<span data-compare-count>0</span>)
      </a>
      <button type="button" class="v6-wl__btn" data-wl-clear hidden>Clear wishlist</button>
    </div>
  </div>

  <div class="v6-wl__loading" data-wl-loading>Loading your wishlist…</div>
  <ul class="v6-wl__grid" data-wl-grid></ul>
  <p class="v6-wl__note" data-wl-note hidden></p>

  <div class="v6-wl__empty" data-wl-empty hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    <h2 class="h3">Your wishlist is empty</h2>
    <p>Tap the heart on any product to save it here for later.</p>
    <a class="v6-wl__btn v6-wl__btn--primary" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Continue shopping</a>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-v6-wishlist]');
    if (!root) return;
    var grid = root.querySelector('[data-wl-grid]');
    var empty = root.querySelector('[data-wl-empty]');
    var loading = root.querySelector('[data-wl-loading]');
    var note = root.querySelector('[data-wl-note]');
    var clearBtn = root.querySelector('[data-wl-clear]');
    var base = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';

    function showEmpty(isEmpty) {
      empty.hidden = !isEmpty;
      clearBtn.hidden = isEmpty;
    }

    function prune() {
      var ids = window.V6Lists.ids('wishlist');
      grid.querySelectorAll(':scope > li').forEach(function (li) {
        if (ids.indexOf(li.getAttribute('data-id')) === -1) li.remove();
      });
      showEmpty(grid.children.length === 0 && ids.length === 0);
    }

    function load() {
      var L = window.V6Lists;
      var ids = L.ids('wishlist');
      var map = L.handles('wishlist');
      loading.hidden = true;
      if (!ids.length) {
        showEmpty(true);
        return;
      }
      loading.hidden = false;
      var withHandle = ids.filter(function (id) { return map[id]; });
      var unknown = ids.length - withHandle.length;

      Promise.all(
        withHandle.map(function (id) {
          return fetch(base + 'products/' + encodeURIComponent(map[id]) + '?view=v6card', { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.text() : (r.status === 404 ? null : ''); })
            .then(function (html) { return { id: id, html: html }; })
            .catch(function () { return { id: id, html: '' }; });
        })
      ).then(function (results) {
        loading.hidden = true;
        grid.innerHTML = '';
        results.forEach(function (res) {
          if (res.html === null) {
            L.remove('wishlist', res.id); // product no longer exists
            return;
          }
          if (!res.html) return;
          var li = document.createElement('li');
          li.setAttribute('data-id', res.id);
          li.innerHTML = res.html;
          grid.appendChild(li);
        });
        if (unknown > 0) {
          note.hidden = false;
          note.textContent = unknown + ' item(s) saved earlier could not be shown. Open them again and tap the heart to re-save.';
        }
        showEmpty(grid.children.length === 0 && L.ids('wishlist').length === 0);
        L.sync();
      });
    }

    clearBtn.addEventListener('click', function () {
      window.V6Lists.clear('wishlist');
      grid.innerHTML = '';
      note.hidden = true;
      showEmpty(true);
    });

    document.addEventListener('v6:lists-change', function (e) {
      if (e.detail && e.detail.name === 'wishlist') prune();
    });

    function start() {
      if (window.V6Lists) load();
      else setTimeout(start, 50);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
</script>

{% schema %}
{
  "name": "V6 Wishlist",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "url", "id": "shop_link", "label": "Continue shopping link" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "V6 Wishlist" }]
}
{% endschema %}
