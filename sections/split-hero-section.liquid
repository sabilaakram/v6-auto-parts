<style>
  .split-hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ section.settings.section_height }}px;
    overflow: hidden;
    gap: 0;
  }

  .split-hero-panel {
    display: flex;
    flex-direction: column;
    padding: {{ section.settings.panel_padding }}px;
    position: relative;
    align-items: {{ section.settings.content_align_horizontal }};
    justify-content: {{ section.settings.content_align_vertical }};
  }

  .split-hero-panel.left {
    background-color: {{ section.settings.left_bg_color }};
    clip-path: polygon(0 0, 92% 0, 80% 100%, 0 100%);
  }

  .split-hero-panel.right {
    background-color: {{ section.settings.right_bg_color }};
    clip-path: polygon(8% 0, 100% 0, 100% 100%, 20% 100%);
  }

  .split-hero-content {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px;
    text-align: {{ section.settings.text_align }};
    width: 100%;
    max-width: 90%;
  }

  .split-hero-heading {
    font-family: {{ section.settings.heading_font_family }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    color: {{ section.settings.heading_text_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_text_transform }};
    order: {{ section.settings.heading_order }};
  }

  .split-hero-subheading {
    font-family: {{ section.settings.subheading_font_family }};
    font-size: {{ section.settings.subheading_font_size }}px;
    font-weight: {{ section.settings.subheading_font_weight }};
    color: {{ section.settings.subheading_text_color }};
    margin: 0;
    line-height: 1.5;
    letter-spacing: {{ section.settings.subheading_letter_spacing }}px;
    order: {{ section.settings.subheading_order }};
  }

  .split-hero-button {
    display: inline-{% if section.settings.button_full_width %}block{% else %}block{% endif %};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    text-decoration: none;
    font-family: {{ section.settings.button_font_family }};
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    text-transform: {{ section.settings.button_text_transform }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    order: {{ section.settings.button_order }};
    width: fit-content;
    align-self: {{ section.settings.button_align }};
  }

  .split-hero-button:hover {
    background-color: {{ section.settings.button_bg_color_hover }};
    color: {{ section.settings.button_text_color_hover }};
    transform: {{ section.settings.button_hover_effect }};
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .split-hero-section {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .split-hero-panel {
      padding: {{ section.settings.panel_padding_mobile }}px;
      min-height: {{ section.settings.section_height_mobile }}px;
    }

    .split-hero-panel.left {
      clip-path: none;
    }

    .split-hero-panel.right {
      clip-path: none;
    }

    .split-hero-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .split-hero-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }

    .split-hero-button {
      font-size: {{ section.settings.button_font_size_mobile }}px;
      padding: {{ section.settings.button_padding_vertical_mobile }}px {{ section.settings.button_padding_horizontal_mobile }}px;
    }

    .split-hero-content {
      gap: {{ section.settings.content_gap_mobile }}px;
    }
  }

  @media (max-width: 480px) {
    .split-hero-section {
      min-height: auto;
    }

    .split-hero-panel {
      padding: {{ section.settings.panel_padding_mobile }}px;
      min-height: {{ section.settings.section_height_mobile }}px;
      justify-content: center;
    }

    .split-hero-heading {
      font-size: {{ section.settings.heading_font_size_mobile }}px;
    }

    .split-hero-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile }}px;
    }
  }
</style>

<section class="split-hero-section">
  <!-- Left Panel -->
  <div class="split-hero-panel left">
    <div class="split-hero-content">
      <h2 class="split-hero-heading">{{ section.settings.left_heading }}</h2>
      <p class="split-hero-subheading">{{ section.settings.left_subheading }}</p>
      <a href="{{ section.settings.left_button_link }}" class="split-hero-button">{{ section.settings.left_button_text }}</a>
    </div>
  </div>

  <!-- Right Panel -->
  <div class="split-hero-panel right">
    <div class="split-hero-content">
      <h2 class="split-hero-heading">{{ section.settings.right_heading }}</h2>
      <p class="split-hero-subheading">{{ section.settings.right_subheading }}</p>
      <a href="{{ section.settings.right_button_link }}" class="split-hero-button">{{ section.settings.right_button_text }}</a>
    </div>
  </div>
</section>

