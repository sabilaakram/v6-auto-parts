{% comment %}
  Renders the "Wishlist + compare buttons" block on the product page.
  Clicks are handled site-wide by assets/v6-wishlist.js (same "v6-wishlist" /
  "v6-compare" lists as the product cards), which also shows a confirmation
  toast with a link to the Wishlist / Compare pages.

  Accepts:
  - block: {Object} the "ai_wishlist_compare" block from main-product.liquid

  Usage:
  {% render 'ai-wishlist-compare', block: block %}
{% endcomment %}

{% if block.settings.show_wishlist or block.settings.show_compare %}
  {% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

  {% style %}
    .ai-wishlist-compare-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin: 12px 0 0 0;
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 40px;
      padding: 0 16px;
      border-radius: 999px;
      border: 1px solid #d7d7d7;
      background: #ffffff;
      color: #333333;
      font-size: 1.35rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }}:hover {
      border-color: #a50000;
      color: #a50000;
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      transition: fill 0.2s ease, stroke 0.2s ease;
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }}.is-active {
      border-color: #a50000;
      color: #a50000;
      background: rgba(165, 0, 0, 0.05);
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }}[data-wishlist-toggle].is-active svg {
      fill: #a50000;
      stroke: #a50000;
    }

    .ai-wishlist-compare__button-{{ ai_gen_id }} .is-on { display: none; }
    .ai-wishlist-compare__button-{{ ai_gen_id }}.is-active .is-on { display: inline; }
    .ai-wishlist-compare__button-{{ ai_gen_id }}.is-active .is-off { display: none; }
  {% endstyle %}

  <div class="ai-wishlist-compare-{{ ai_gen_id }} quick-add-hidden" {{ block.shopify_attributes }}>
    {% if block.settings.show_wishlist %}
      <button
        type="button"
        class="ai-wishlist-compare__button-{{ ai_gen_id }}"
        data-wishlist-toggle
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        aria-label="Add to wishlist"
      >
        {{ 'icon-heart.svg' | inline_asset_content }}
        <span class="is-off">Wishlist</span>
        <span class="is-on">Saved</span>
      </button>
    {% endif %}
    {% if block.settings.show_compare %}
      <button
        type="button"
        class="ai-wishlist-compare__button-{{ ai_gen_id }}"
        data-compare-toggle
        data-product-id="{{ product.id }}"
        data-product-handle="{{ product.handle }}"
        aria-label="Add to compare"
      >
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M7 4v13M7 17l-3-3M7 17l3-3M17 20V7M17 7l-3 3M17 7l3 3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="is-off">Compare</span>
        <span class="is-on">Comparing</span>
      </button>
    {% endif %}
  </div>
{% endif %}
