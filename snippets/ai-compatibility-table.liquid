{% comment %}
  Renders the "Compatibility table" local block on the product page: a table
  parsed from a multi-line-text product metafield (namespace.key), paginated
  client-side (N rows per page, configurable). Hidden entirely if the
  metafield is blank on this product.

  Metafield format — first line is the column headers (comma-separated),
  every line after that is one row (comma-separated cells). Example:
    Make,Model,Year,Engine
    Toyota,Yaris,2005-2011,1.3L Petrol
    Toyota,Vitz,2005-2011,1.0L Petrol

  Shopify caps a single text metafield at 64KB, which a large fitment list
  (400+ rows) can exceed. To support that, this snippet transparently merges
  in up to two continuation metafields — <key>_part2 and <key>_part3, same
  namespace, no header row, just more comma-separated data rows — appended
  after the main metafield's rows if present. Blank/missing parts are a
  no-op, so this is fully backward compatible with a single metafield.

  Accepts:
  - block: {Object} the "ai_compatibility_table" block from main-product.liquid

  Usage:
  {% render 'ai-compatibility-table', block: block %}
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% capture newline %}
{% endcapture %}

{% liquid
  assign mf_value = blank
  assign raw_key = block.settings.metafield_key
  if raw_key != blank
    assign parts = raw_key | strip | split: '.'
    if parts.size == 2
      assign mf_value = product.metafields[parts[0]][parts[1]].value
      assign part2_key = parts[1] | append: '_part2'
      assign part3_key = parts[1] | append: '_part3'
      assign mf_value_part2 = product.metafields[parts[0]][part2_key].value
      assign mf_value_part3 = product.metafields[parts[0]][part3_key].value
      if mf_value_part2 != blank
        assign mf_value = mf_value | append: newline | append: mf_value_part2
      endif
      if mf_value_part3 != blank
        assign mf_value = mf_value | append: newline | append: mf_value_part3
      endif
    endif
  endif
%}

{% if mf_value != blank %}
  {% liquid
    assign lines = mf_value | strip | split: newline
    assign header_cells = lines[0] | split: ','
    assign last_column_index = header_cells.size | minus: 1
    assign rows_per_page = block.settings.rows_per_page | default: 20

    assign total_rows = 0
    for line in lines
      unless forloop.first
        assign trimmed_line = line | strip
        if trimmed_line != blank
          assign total_rows = total_rows | plus: 1
        endif
      endunless
    endfor
  %}

  {% style %}
    .ai-compat-{{ ai_gen_id }} {
      margin: 24px 0;
    }

    .ai-compat__heading-{{ ai_gen_id }} {
      text-align: center;
      font-family: 'Bebas Neue', sans-serif;
      font-weight: 400;
      font-size: 48px;
      color: #111111;
      margin: 0 0 4px 0;
    }

    @media screen and (max-width: 749px) {
      .ai-compat__heading-{{ ai_gen_id }} {
        font-size: 24px;
      }
    }

    .ai-compat__subheading-{{ ai_gen_id }} {
      font-size: 13px;
      color: #777777;
      margin: 0 0 16px 0;
    }

    .ai-compat__table-wrap-{{ ai_gen_id }} {
      width: 100%;
      overflow-x: auto;
      border: 1px solid {{ block.settings.divider_color }};
      border-radius: 6px;
    }

    .ai-compat__table-{{ ai_gen_id }} tbody tr:nth-child(even) {
      background: #fafafa;
    }

    .ai-compat__table-{{ ai_gen_id }} {
      width: 100%;
      border-collapse: collapse;
      font-family: {{ block.settings.table_font.family }}, {{ block.settings.table_font.fallback_families }};
      font-weight: {{ block.settings.table_font.weight }};
      font-style: {{ block.settings.table_font.style }};
      font-size: {{ block.settings.table_font_size }}px;
      white-space: nowrap;
    }

    .ai-compat__table-{{ ai_gen_id }} th,
    .ai-compat__table-{{ ai_gen_id }} td {
      text-align: left;
      padding: 10px 16px;
      border-bottom: 1px solid {{ block.settings.divider_color }};
    }

    .ai-compat__table-{{ ai_gen_id }} thead th {
      background: {{ block.settings.header_bg_color }};
      color: {{ block.settings.header_text_color }};
      font-weight: 600;
      position: sticky;
      top: 0;
    }

    .ai-compat__table-{{ ai_gen_id }} tbody td {
      color: {{ block.settings.row_text_color }};
    }

    .ai-compat__table-{{ ai_gen_id }} tbody tr[hidden] {
      display: none;
    }

    .ai-compat__pagination-{{ ai_gen_id }} {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .ai-compat__page-button-{{ ai_gen_id }} {
      min-width: 32px;
      height: 32px;
      padding: 0 8px;
      border: 1px solid {{ block.settings.divider_color }};
      background: #ffffff;
      border-radius: 4px;
      cursor: pointer;
      font-family: {{ block.settings.table_font.family }}, {{ block.settings.table_font.fallback_families }};
      font-size: 13px;
      color: {{ block.settings.row_text_color }};
    }

    .ai-compat__page-button-{{ ai_gen_id }}.is-active {
      background: #a50000;
      border-color: #a50000;
      color: #ffffff;
    }

    .ai-compat__page-button-{{ ai_gen_id }}:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .ai-compat__page-ellipsis-{{ ai_gen_id }} {
      min-width: 32px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: {{ block.settings.table_font.family }}, {{ block.settings.table_font.fallback_families }};
      font-size: 13px;
      color: {{ block.settings.row_text_color }};
      user-select: none;
    }
  {% endstyle %}

  <div class="ai-compat-{{ ai_gen_id }} quick-add-hidden" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="ai-compat__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}
    <p class="ai-compat__subheading-{{ ai_gen_id }}">
      This part is compatible with {{ total_rows }} vehicle{% if total_rows != 1 %}s{% endif %}.
    </p>

    <ai-compat-table-{{ ai_gen_id }} data-rows-per-page="{{ rows_per_page }}">
      <div class="ai-compat__table-wrap-{{ ai_gen_id }}">
        <table class="ai-compat__table-{{ ai_gen_id }}">
          <thead>
            <tr>
              {% for cell in header_cells %}
                <th>{{ cell | strip }}</th>
              {% endfor %}
            </tr>
          </thead>
          <tbody data-compat-body>
            {% assign row_index = 0 %}
            {% for line in lines %}
              {% unless forloop.first %}
                {% assign trimmed_line = line | strip %}
                {% if trimmed_line != blank %}
                  {% assign cells = trimmed_line | split: ',' %}
                  <tr data-row-index="{{ row_index }}">
                    {% for i in (0..last_column_index) %}
                      {% assign cell_value = cells[i] | default: '' %}
                      <td>{{ cell_value | strip }}</td>
                    {% endfor %}
                  </tr>
                  {% assign row_index = row_index | plus: 1 %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="ai-compat__pagination-{{ ai_gen_id }}" data-compat-pagination></div>
    </ai-compat-table-{{ ai_gen_id }}>
  </div>

  <script>
    (function () {
      var tagName = 'ai-compat-table-{{ ai_gen_id }}';
      if (customElements.get(tagName)) return;

      customElements.define(tagName, class extends HTMLElement {
        connectedCallback() {
          this.rowsPerPage = parseInt(this.dataset.rowsPerPage, 10) || 20;
          this.body = this.querySelector('[data-compat-body]');
          this.pagination = this.querySelector('[data-compat-pagination]');
          this.rows = Array.prototype.slice.call(this.body.querySelectorAll('tr'));
          this.totalPages = Math.max(1, Math.ceil(this.rows.length / this.rowsPerPage));
          this.currentPage = 1;
          this.renderPage(1);
        }

        renderPage(page) {
          this.currentPage = Math.min(Math.max(page, 1), this.totalPages);

          this.rows.forEach(function (row, index) {
            var rowPage = Math.floor(index / this.rowsPerPage) + 1;
            row.hidden = rowPage !== this.currentPage;
          }, this);

          this.renderPagination();
        }

        // Returns page numbers to display, condensed with '...' gaps — e.g.
        // for 71 pages on page 5: [1, '...', 4, 5, 6, '...', 71]. Always
        // keeps the first page, the last page, and one sibling on each
        // side of the current page; collapses everything else.
        getPageNumbers() {
          var total = this.totalPages;
          var current = this.currentPage;
          var siblingCount = 1;
          var boundaryCount = 1;
          var pages = [];

          for (var i = 1; i <= total; i++) {
            if (
              i <= boundaryCount ||
              i > total - boundaryCount ||
              (i >= current - siblingCount && i <= current + siblingCount)
            ) {
              pages.push(i);
            }
          }

          var withGaps = [];
          var last = 0;
          pages.forEach(function (page) {
            if (last) {
              if (page - last === 2) {
                withGaps.push(last + 1);
              } else if (page - last > 1) {
                withGaps.push('...');
              }
            }
            withGaps.push(page);
            last = page;
          });

          return withGaps;
        }

        renderPagination() {
          this.pagination.innerHTML = '';
          if (this.totalPages <= 1) return;

          var makeButton = function (label, page, active) {
            var button = document.createElement('button');
            button.type = 'button';
            button.className = 'ai-compat__page-button-{{ ai_gen_id }}' + (active ? ' is-active' : '');
            button.textContent = label;
            button.setAttribute('aria-label', label === '‹' ? 'Previous page' : label === '›' ? 'Next page' : 'Page ' + label);
            button.addEventListener('click', function () {
              this.renderPage(page);
              this.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }.bind(this));
            return button;
          }.bind(this);

          var makeEllipsis = function () {
            var span = document.createElement('span');
            span.className = 'ai-compat__page-ellipsis-{{ ai_gen_id }}';
            span.textContent = '…';
            span.setAttribute('aria-hidden', 'true');
            return span;
          };

          if (this.currentPage > 1) {
            this.pagination.appendChild(makeButton('‹', this.currentPage - 1, false));
          }

          this.getPageNumbers().forEach(function (page) {
            if (page === '...') {
              this.pagination.appendChild(makeEllipsis());
            } else {
              this.pagination.appendChild(makeButton(String(page), page, page === this.currentPage));
            }
          }, this);

          if (this.currentPage < this.totalPages) {
            this.pagination.appendChild(makeButton('›', this.currentPage + 1, false));
          }
        }
      });
    })();
  </script>
{% endif %}
