{% comment %}
  Renders the "Feature grid" local block on the product page: 3 columns, each
  with an icon, a heading and a short line of text.

  Accepts:
  - block: {Object} the "ai_feature_grid" block from main-product.liquid

  Usage:
  {% render 'ai-feature-grid', block: block %}
{% endcomment %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign has_any_item = false
  for i in (1..3)
    assign enabled_key = 'item_' | append: i | append: '_enabled'
    if block.settings[enabled_key]
      assign has_any_item = true
    endif
  endfor
%}

{% if has_any_item %}
  {% style %}
    .ai-feature-grid-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin: 24px 0;
    }

    .ai-feature-grid__item-{{ ai_gen_id }} {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    .ai-feature-grid__icon-{{ ai_gen_id }} {
      width: 60px;
      height: 60px;
      flex: 0 0 auto;
      border-radius: 50%;
      border: 1px solid {{ block.settings.icon_color }};
      color: {{ block.settings.icon_color }};
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ai-feature-grid__icon-{{ ai_gen_id }} svg {
      width: 28px;
      height: 28px;
    }

    .ai-feature-grid__heading-{{ ai_gen_id }} {
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
      font-weight: {{ block.settings.heading_font.weight }};
      font-style: {{ block.settings.heading_font.style }};
      color: {{ block.settings.heading_color }};
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-size: 15px;
      margin: 0;
    }

    .ai-feature-grid__text-{{ ai_gen_id }} {
      font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
      font-weight: {{ block.settings.text_font.weight }};
      font-style: {{ block.settings.text_font.style }};
      color: {{ block.settings.text_color }};
      font-size: 13px;
      line-height: 1.5;
      margin: 0;
    }

    @media screen and (max-width: 749px) {
      .ai-feature-grid-{{ ai_gen_id }} {
        grid-template-columns: 1fr;
        gap: 28px;
      }
    }
  {% endstyle %}

  <div class="quick-add-hidden" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="ai-section-heading">{{ block.settings.heading }}</h2>
    {% endif %}
    <div class="ai-feature-grid-{{ ai_gen_id }} ai-section-narrow">
    {% for i in (1..3) %}
      {% assign enabled_key = 'item_' | append: i | append: '_enabled' %}
      {% assign icon_key = 'item_' | append: i | append: '_icon' %}
      {% assign heading_key = 'item_' | append: i | append: '_heading' %}
      {% assign text_key = 'item_' | append: i | append: '_text' %}
      {% if block.settings[enabled_key] %}
        <div class="ai-feature-grid__item-{{ ai_gen_id }}">
          {% if block.settings[icon_key] != blank %}
            <span class="ai-feature-grid__icon-{{ ai_gen_id }}">{{ block.settings[icon_key] }}</span>
          {% endif %}
          {% if block.settings[heading_key] != blank %}
            <h3 class="ai-feature-grid__heading-{{ ai_gen_id }}">{{ block.settings[heading_key] }}</h3>
          {% endif %}
          {% if block.settings[text_key] != blank %}
            <p class="ai-feature-grid__text-{{ ai_gen_id }}">{{ block.settings[text_key] }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
    </div>
  </div>
{% endif %}
