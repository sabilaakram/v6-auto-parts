{% comment %}
  Renders a centered, red-underlined heading — used above Description (which
  has no native heading) and reused visually by Specification/Compatibility/
  Feature grid via the shared .ai-section-heading class.

  Accepts:
  - block: {Object} the "ai_section_heading" block from main-product.liquid

  Usage:
  {% render 'ai-section-heading', block: block %}
{% endcomment %}

{% if block.settings.heading != blank %}
  <h2 class="ai-section-heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
{% endif %}
