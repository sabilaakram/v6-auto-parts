{% comment %}
  Renders a product card - V6 Auto Parts style (matches the homepage "Featured product tabs" cards).

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} unused, kept for compatibility
  - show_secondary_image: {Boolean} unused, kept for compatibility
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: true
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - quick_add: {Boolean/String} Show the add-to-cart button. Default: true
  - enable_quick_view: {Boolean} Clicking the image opens a quick-view popup. Default: true
  - section_id: {String} The ID of the section that contains this card.

  Usage:
  {% render 'card-product', card_product: product, show_vendor: false, show_rating: true %}
{% endcomment %}

{%- liquid
  assign show_rating = show_rating | default: true
  if enable_quick_view == nil
    assign enable_quick_view = true
  endif
  if quick_add == blank
    assign quick_add = true
  endif
  assign card_section_id = section_id | default: section.id
-%}

{%- unless skip_styles -%}
<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid rgba(202, 38, 41, 0.22);
    border-radius: 6px;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
    position: relative;
  }

  .product-card:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
  }

  .product-card__image-wrapper {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease, transform-origin 0.05s linear;
    transform-origin: center center;
  }

  .product-card:hover .product-card__image {
    transform: scale(2);
  }

  .product-card__sale-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    background: #a50000;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 10px 2px 10px 2px;
    pointer-events: none;
  }

  .product-card__wishlist {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #d7d7d7;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .product-card:hover .product-card__wishlist,
  .product-card__wishlist:focus-visible,
  .product-card__wishlist.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__wishlist svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #686868;
    stroke-width: 1.8;
    transition: fill 0.2s ease, stroke 0.2s ease;
  }

  .product-card__wishlist.is-active svg {
    fill: #a50000;
    stroke: #a50000;
  }

  .product-card__quick-view-hint {
    position: absolute;
    left: 50%;
    bottom: 12px;
    transform: translate(-50%, 8px);
    z-index: 2;
    background: rgba(17, 17, 17, 0.82);
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.2s ease, transform 0.2s ease;
    pointer-events: none;
    white-space: nowrap;
  }

  .product-card:hover .product-card__quick-view-hint {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    gap: 12px;
    padding: 16px 18px 18px;
  }

  .product-card__vendor {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #a50000;
  }

  .product-card__title {
    margin: 0;
    font-family: inherit;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.35;
    color: #111111;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .product-card:hover .product-card__title a {
    color: #a50000;
  }

  .product-card__rating {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .product-card__stars {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }

  .product-card__stars-track,
  .product-card__stars-fill {
    display: flex;
    gap: 2px;
  }

  .product-card__stars-track svg {
    width: 14px;
    height: 14px;
    fill: #e2e2e2;
  }

  .product-card__stars-fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .product-card__stars-fill svg {
    width: 14px;
    height: 14px;
    fill: #f0a911;
    flex: 0 0 14px;
  }

  .product-card__rating-count {
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #868686;
  }

  .product-card__footer {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }

  .product-card__price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-card__price-current {
    font-size: 18px;
    color: #111111;
  }

  .product-card__price.has-sale .product-card__price-current {
    color: #a50000;
    font-weight: 600;
  }

  .product-card__price-compare {
    font-size: 13px;
    color: #868686;
    text-decoration: line-through;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 18px;
    border: none;
    border-radius: 4px;
    background: #a50000;
    color: #ffffff;
    font-family: inherit;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .product-card__cta:hover {
    background: #111111;
  }

  .product-card__cta[aria-disabled='true'],
  .product-card__cta:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  .product-card__cta .loading__spinner {
    width: 15px;
    height: 15px;
  }

  .product-card__cta .loading__spinner svg {
    width: 100%;
    height: 100%;
  }

  /* List view (toggled by a parent .product-grid--list class) */
  .product-grid--list .product-card {
    flex-direction: row;
  }

  .product-grid--list .product-card__image-wrapper {
    width: 200px;
    flex: 0 0 200px;
    aspect-ratio: 1 / 1;
  }

  .product-grid--list .product-card__body {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .product-grid--list .product-card__footer {
    margin-top: 0;
    margin-left: auto;
  }

  @media (max-width: 749px) {
    .product-grid--list .product-card {
      flex-direction: column;
    }

    .product-grid--list .product-card__image-wrapper {
      width: 100%;
      flex: 0 0 auto;
    }

    .product-grid--list .product-card__body {
      flex-direction: column;
      align-items: stretch;
    }

    .product-grid--list .product-card__footer {
      margin-left: 0;
    }
  }

  @media (max-width: 480px) {
    .product-card__body {
      padding: 12px 14px 14px;
      gap: 8px;
    }

    .product-card__title {
      font-size: 14px;
    }

    .product-card__price-current {
      font-size: 16px;
    }

    .product-card__cta {
      padding: 9px 14px;
      font-size: 12px;
    }
  }
</style>
{%- endunless -%}

{%- if card_product and card_product != empty -%}
  {% liquid
    assign on_sale = false
    if card_product.compare_at_price > card_product.price
      assign on_sale = true
      assign discount_percent = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round
    endif
    assign rating = card_product.metafields.reviews.rating.value
    assign rating_count = card_product.metafields.reviews.rating_count
    assign variant = card_product.selected_or_first_available_variant
    assign modal_id = 'QuickView-' | append: card_product.id | append: '-' | append: card_section_id
  %}
  <div class="product-card">
    {% if enable_quick_view %}
      <modal-opener data-modal="#{{ modal_id }}">
        <button
          type="button"
          class="product-card__image-wrapper"
          data-product-url="{{ card_product.url }}"
          aria-haspopup="dialog"
          aria-label="{{ 'products.product.view_full_details' | t | default: 'Quick view' }} — {{ card_product.title | escape }}"
        >
          {% if on_sale %}
            <span class="product-card__sale-badge">-{{ discount_percent }}%</span>
          {% endif %}
          {% if card_product.featured_media %}
            <img
              src="{{ card_product.featured_media | image_url: width: 700 }}"
              srcset="{{ card_product.featured_media | image_url: width: 400 }} 400w, {{ card_product.featured_media | image_url: width: 700 }} 700w, {{ card_product.featured_media | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 990px) 25vw, (min-width: 750px) 40vw, 90vw"
              alt="{{ card_product.featured_media.alt | escape }}"
              class="product-card__image"
              {% unless lazy_load == false %}
                loading="lazy"
              {% endunless %}
              width="{{ card_product.featured_media.width }}"
              height="{{ card_product.featured_media.height }}"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
          {% endif %}
          <span class="loading__spinner hidden">{% render 'loading-spinner' %}</span>
          <span class="product-card__quick-view-hint">{{ 'products.product.view_full_details' | t | default: 'Quick view' }}</span>
        </button>
      </modal-opener>
    {% else %}
      <a href="{{ card_product.url }}" class="product-card__image-wrapper" aria-label="{{ card_product.title | escape }}">
        {% if on_sale %}
          <span class="product-card__sale-badge">-{{ discount_percent }}%</span>
        {% endif %}
        {% if card_product.featured_media %}
          <img
            src="{{ card_product.featured_media | image_url: width: 700 }}"
            alt="{{ card_product.featured_media.alt | escape }}"
            class="product-card__image"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
        {% endif %}
      </a>
    {% endif %}

    <button
      type="button"
      class="product-card__wishlist"
      data-wishlist-toggle
      data-product-id="{{ card_product.id }}"
      aria-label="Add to wishlist"
    >
      {{ 'icon-heart.svg' | inline_asset_content }}
    </button>

    <div class="product-card__body">
      {% if show_vendor and card_product.vendor %}
        <p class="product-card__vendor">{{ card_product.vendor }}</p>
      {% endif %}

      <h3 class="product-card__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      {% if show_rating and rating != blank %}
        <div class="product-card__rating">
          <span class="product-card__stars" aria-hidden="true">
            <span class="product-card__stars-track">
              {% for star in (1..5) %}{{ 'icon-star.svg' | inline_asset_content }}{% endfor %}
            </span>
            <span class="product-card__stars-fill" style="width: {{ rating | times: 20.0 | at_most: 100 }}%;">
              {% for star in (1..5) %}{{ 'icon-star.svg' | inline_asset_content }}{% endfor %}
            </span>
          </span>
          {% if rating_count != blank %}
            <span class="product-card__rating-count">({{ rating_count }})</span>
          {% endif %}
        </div>
      {% endif %}

      <div class="product-card__footer">
        <div class="product-card__price{% if on_sale %} has-sale{% endif %}">
          {% if on_sale %}
            <span class="product-card__price-compare">{{ card_product.compare_at_price | money }}</span>
          {% endif %}
          <span class="product-card__price-current">{{ card_product.price | money }}</span>
        </div>

        {% if quick_add %}
          {% if card_product.has_only_default_variant %}
            <product-form data-hide-errors="true">
              {% form 'product', card_product %}
                <input type="hidden" name="id" value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                <button
                  type="submit"
                  class="product-card__cta"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span>
                    {% if variant.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                  </span>
                  {% render 'loading-spinner' %}
                </button>
              {% endform %}
            </product-form>
          {% else %}
            <a href="{{ card_product.url }}" class="product-card__cta">
              {{ 'products.product.choose_options' | t }}
            </a>
          {% endif %}
        {% else %}
          <a href="{{ card_product.url }}" class="product-card__cta">
            {{ 'products.product.view_full_details' | t | default: 'View Product' }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if enable_quick_view %}
    {% render 'ai-quick-view-modal', product: card_product, modal_id: modal_id, skip_styles: skip_styles %}
  {% endif %}
{%- else -%}
  <div class="product-card">
    <div class="product-card__image-wrapper" style="background: #f0f0f0; cursor: default;">
      {{ 'product-1' | placeholder_svg_tag: 'product-card__image' }}
    </div>
    <div class="product-card__body">
      <h3 class="product-card__title"><a href="#">Product Title</a></h3>
      <div class="product-card__footer">
        <div class="product-card__price">
          <span class="product-card__price-current">{{ 0 | money }}</span>
        </div>
        <button class="product-card__cta" disabled>Add to Cart</button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- unless skip_styles -%}
<script>
  (function () {
    if (window.__aiCardZoomBound) return;
    window.__aiCardZoomBound = true;

    document.addEventListener('mousemove', function (event) {
      const wrapper = event.target.closest('.product-card__image-wrapper');
      if (!wrapper) return;
      const img = wrapper.querySelector('.product-card__image');
      if (!img) return;
      const rect = wrapper.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      img.style.transformOrigin = x + '% ' + y + '%';
    });
  })();
</script>
{%- endunless -%}
