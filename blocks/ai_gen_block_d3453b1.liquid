{% doc %}
  @prompt
    create an infinite text mansory, which can move infinitely and has a text on it, and for the responsiveness the text size will be enlarged or small, the background color will also be changed (i can input it), and also the text i will input the text/s which will move infinitely, and the properties like font, color, size etc will be handled from the frontend
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 {{ block.settings.font_family | font_face: font_display: 'swap' }}
  .ai-infinite-masonry-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-infinite-masonry__track-{{ ai_gen_id }} {
  display: flex;
  width: max-content;
  gap: {{ block.settings.gap }}px;
  padding-right: {{ block.settings.gap }}px;
  animation: ai-masonry-scroll-{{ ai_gen_id }} var(--marquee-duration, 30s) linear infinite;
  will-change: transform;
}

  .ai-infinite-masonry__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-infinite-masonry__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    white-space: nowrap;
    padding: {{ block.settings.item_padding_vertical }}px {{ block.settings.item_padding_horizontal }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  @keyframes ai-masonry-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
  .ai-infinite-masonry-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_vertical_mobile }}px 0;
  }

  .ai-infinite-masonry__track-{{ ai_gen_id }} {
    gap: {{ block.settings.gap_mobile }}px;
    padding-right: {{ block.settings.gap_mobile }}px;
  }

  .ai-infinite-masonry__item-{{ ai_gen_id }} {
    font-size: {{ block.settings.font_size_mobile }}px;
    padding-left: {{ block.settings.item_padding_horizontal_mobile }}px;
    padding-right: {{ block.settings.item_padding_horizontal_mobile }}px;
  }
}
{% endstyle %}

<infinite-text-masonry-{{ ai_gen_id }}
  class="ai-infinite-masonry-{{ ai_gen_id }}"
  data-speed-desktop="{{ block.settings.speed_desktop }}"
  data-speed-mobile="{{ block.settings.speed_mobile }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-infinite-masonry__track-{{ ai_gen_id }}">
    {% liquid
      assign text_items = block.settings.text_items | split: ','
      assign total_items = text_items.size
    %}

    {% if total_items > 0 %}
      {% for i in (1..2) %}
        {% for item in text_items %}
          {% assign trimmed_item = item | strip %}
          {% if trimmed_item != blank %}
            <div class="ai-infinite-masonry__item-{{ ai_gen_id }}">
              {{ trimmed_item }}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      {% for i in (1..2) %}
        <div class="ai-infinite-masonry__item-{{ ai_gen_id }}">
          Next, add your text items
        </div>
        <div class="ai-infinite-masonry__item-{{ ai_gen_id }}">
          Separate with commas
        </div>
        <div class="ai-infinite-masonry__item-{{ ai_gen_id }}">
          Your text here
        </div>
      {% endfor %}
    {% endif %}
  </div>
</infinite-text-masonry-{{ ai_gen_id }}>

<script>
  (function () {
    const tag = 'infinite-text-masonry-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;

    class InfiniteTextMasonry extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-infinite-masonry__track-{{ ai_gen_id }}');
        if (!this.track) return;

        const items = Array.from(this.track.children);
        this.baseItems = items.slice(0, items.length / 2);
        this.mobileQuery = window.matchMedia('(max-width: 749px)');
        this.lastWidth = 0;

        this.build();
        if (document.fonts) document.fonts.ready.then(() => this.build());

        this.observer = new ResizeObserver(() => {
          if (this.offsetWidth !== this.lastWidth) this.build();
        });
        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      build() {
        this.lastWidth = this.offsetWidth;
        this.track.replaceChildren(...this.baseItems);

        const setWidth = this.track.offsetWidth;
        if (!setWidth || !this.lastWidth) return;

        // Each half of the track must be at least as wide as the container
        const copies = Math.ceil(this.lastWidth / setWidth);
        const fragment = document.createDocumentFragment();

        for (let i = 1; i < copies * 2; i++) {
          this.baseItems.forEach((item) => fragment.appendChild(item.cloneNode(true)));
        }
        this.track.appendChild(fragment);

        const speed = Number(
          this.mobileQuery.matches ? this.dataset.speedMobile : this.dataset.speedDesktop
        );
        this.track.style.setProperty('--marquee-duration', `${(setWidth * copies) / speed}s`);
      }
    }

    customElements.define(tag, InfiniteTextMasonry);
  })();
</script>

{% schema %}
{
  "name": "Infinite text masonry",
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "textarea",
      "id": "text_items",
      "label": "Text items",
      "info": "Separate multiple items with commas",
      "default": "Quality Auto Parts, Fast Shipping, Trusted Service, Best Prices, Expert Support"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "font_picker",
      "id": "font_family",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "font_size",
