    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Desktop vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "label": "Mobile vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
  "type": "range",
  "id": "gap_mobile",
  "label": "Mobile gap between items",
  "min": 4,
  "max": 40,
  "step": 4,
  "unit": "px",
  "default": 8
},
{
  "type": "range",
  "id": "item_padding_horizontal_mobile",
  "label": "Mobile item horizontal padding",
  "min": 4,
  "max": 40,
  "step": 2,
  "unit": "px",
  "default": 12
},
    {
      "type": "header",
      "content": "Animation"
