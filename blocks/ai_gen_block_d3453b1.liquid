  "info": "Pixels per second"
},
{
  "type": "range",
  "id": "speed_mobile",
  "label": "Mobile speed",
  "min": 20,
  "max": 200,
  "step": 10,
  "unit": "px",
  "default": 60,
  "info": "Pixels per second"
}
  ],
  "presets": [
