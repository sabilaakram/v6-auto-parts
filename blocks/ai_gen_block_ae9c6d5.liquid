{% doc %}
  @prompt
    Create a fully customizable Shopify announcement / benefits bar section similar to a premium ecommerce trust bar.
    
    The section must be full width and contain multiple horizontal icon boxes / benefit items. Each item should contain:
    
    An icon
    Main heading/text
    Optional sub-text
    
    I should be able to add, remove, duplicate, and reorder unlimited benefit/icon items from the Shopify Theme Editor using blocks.
    
    Section Settings
    
    Add frontend Theme Editor controls for:
    
    Full-width layout
    Background color
    Section height
    Top and bottom padding
    Left and right padding
    Maximum content width if needed
    Content alignment: Left / Center / Right
    Horizontal gap between benefit items
    Vertical alignment of all items
    Optional top/bottom border
    Individual Icon Box Settings
    
    Each block must allow me to customize:
    
    Upload/select an icon or SVG
    Icon size
    Icon position
    Main text
    Sub-text
    Optional link
    Individual alignment if required
    Typography Controls
    
    Provide Theme Editor settings for both main text and sub-text:
    
    Text color
    Font size
    Font family using Shopify theme fonts
    Font weight
    Font style
    Line height
    Letter spacing
    Text transformation/case:
    Normal
    Uppercase
    Lowercase
    Capitalize
    
    Main text and sub-text should be styled independently.
    
    Desktop Layout
    
    On desktop/tablet:
    
    Display all benefit/icon boxes horizontally in one row when space allows
    Allow positioning/alignment as:
    Left
    Center
    Right
    Space-between
    Space-around
    Space-evenly
    Keep icons and text vertically centered
    Do not force equal-width blocks unless selected through a setting
    
    The layout should look similar to:
    
    [Icon] Free Delivery – For orders above £25
    
    [Icon] Klarna – Pay in 30 Days
    
    [Icon] Price Match – Promise
    
    Mobile Behaviour — Infinite Carousel
    
    On mobile devices, convert the benefit items into a smooth continuously looping infinite horizontal carousel / marquee.
    
    Requirements:
    
    Infinite seamless loop
    No visible jump when restarting
    Automatically duplicate items internally if required for seamless looping
    Continuous smooth animation
    Adjustable carousel speed from Theme Editor
    Option to pause animation on hover for desktop if carousel is enabled there
    No scrollbar
    No pagination dots
    No navigation arrows
    Items must remain on a single horizontal line
    Do not stack blocks vertically
    Preserve the icon + main text + sub-text layout
    
    Add a mobile setting for:
    
    Carousel speed
    Gap between items
    Mobile section height
    Mobile font sizes
    Mobile icon size
    Mobile horizontal padding
    Responsive Requirements
    
    Make the section fully responsive for:
    
    Desktop
    Tablet
    Mobile
    
    Desktop and mobile settings should be independently adjustable wherever practical., th icon, main text and the sub text all will be in one row, not vertically stacked
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefit-bar-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    border-top: {% if block.settings.show_border_top %}{{ block.settings.border_thickness }}px solid {{ block.settings.border_color }}{% else %}none{% endif %};
    border-bottom: {% if block.settings.show_border_bottom %}{{ block.settings.border_thickness }}px solid {{ block.settings.border_color }}{% else %}none{% endif %};
    overflow: hidden;
  }

  .ai-benefit-bar-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
    min-height: {{ block.settings.section_height }}px;
  }

  .ai-benefit-bar-desktop-{{ ai_gen_id }} {
    display: none;
    align-items: {{ block.settings.vertical_alignment }};
    {% if block.settings.desktop_layout == 'left' %}
      justify-content: flex-start;
    {% elsif block.settings.desktop_layout == 'center' %}
      justify-content: center;
    {% elsif block.settings.desktop_layout == 'right' %}
      justify-content: flex-end;
    {% elsif block.settings.desktop_layout == 'space-between' %}
      justify-content: space-between;
    {% elsif block.settings.desktop_layout == 'space-around' %}
      justify-content: space-around;
    {% elsif block.settings.desktop_layout == 'space-evenly' %}
      justify-content: space-evenly;
    {% endif %}
    gap: {{ block.settings.horizontal_gap }}px;
    flex-wrap: wrap;
    min-height: {{ block.settings.section_height }}px;
  }

  .ai-benefit-bar-mobile-{{ ai_gen_id }} {
    display: block;
  }

  .ai-benefit-bar-carousel-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.mobile_gap }}px;
    min-height: {{ block.settings.mobile_section_height }}px;
    animation: ai-benefit-bar-scroll-{{ ai_gen_id }} {{ block.settings.carousel_speed }}s linear infinite;
    width: fit-content;
  }

  .ai-benefit-bar-carousel-{{ ai_gen_id }}:hover {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @keyframes ai-benefit-bar-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-benefit-item-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.item_vertical_alignment }};
    gap: {{ block.settings.icon_text_gap }}px;
    text-align: {{ block.settings.content_alignment }};
    flex-shrink: 0;
  }

  .ai-benefit-item-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-benefit-item-icon-{{ ai_gen_id }} img,
  .ai-benefit-item-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-benefit-item-content-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.item_vertical_alignment }};
    gap: {{ block.settings.text_gap }}px;
    flex-wrap: nowrap;
  }

  .ai-benefit-item-main-text-{{ ai_gen_id }} {
    color: {{ block.settings.main_text_color }};
    font-size: {{ block.settings.main_text_size }}px;
    font-family: {{ block.settings.main_text_font.family }}, {{ block.settings.main_text_font.fallback_families }};
    font-weight: {{ block.settings.main_text_font.weight }};
    font-style: {{ block.settings.main_text_font_style }};
    line-height: {{ block.settings.main_text_line_height }};
    letter-spacing: {{ block.settings.main_text_letter_spacing }}px;
    text-transform: {{ block.settings.main_text_transform }};
    margin: 0;
    white-space: nowrap;
  }

  .ai-benefit-item-sub-text-{{ ai_gen_id }} {
    color: {{ block.settings.sub_text_color }};
    font-size: {{ block.settings.sub_text_size }}px;
    font-family: {{ block.settings.sub_text_font.family }}, {{ block.settings.sub_text_font.fallback_families }};
    font-weight: {{ block.settings.sub_text_font.weight }};
    font-style: {{ block.settings.sub_text_font_style }};
    line-height: {{ block.settings.sub_text_line_height }};
    letter-spacing: {{ block.settings.sub_text_letter_spacing }}px;
    text-transform: {{ block.settings.sub_text_transform }};
    margin: 0;
    white-space: nowrap;
  }

  .ai-benefit-item-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: {{ block.settings.item_vertical_alignment }};
    gap: {{ block.settings.icon_text_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-benefit-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    }

    .ai-benefit-bar-desktop-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-benefit-bar-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-benefit-item-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size }}px;
      height: {{ block.settings.icon_size }}px;
    }

    .ai-benefit-item-main-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_text_size }}px;
    }

    .ai-benefit-item-sub-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.sub_text_size }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefit-bar-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding_vertical }}px {{ block.settings.mobile_padding_horizontal }}px;
    }

    .ai-benefit-bar-container-{{ ai_gen_id }} {
      max-width: 100%;
      min-height: {{ block.settings.mobile_section_height }}px;
    }

    .ai-benefit-bar-carousel-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_section_height }}px;
    }

    .ai-benefit-item-icon-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-benefit-item-main-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_main_text_size }}px;
    }

    .ai-benefit-item-sub-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_sub_text_size }}px;
    }
  }
{% endstyle %}

