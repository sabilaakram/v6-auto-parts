{% doc %}
  @prompt
    Create a responsive full-width promotional discount banner with a clean white background.
    
    On desktop, use a 70/30 two-column layout.
    
    Left side: At the top, show a small red rectangular badge saying “WINTER SAVINGS” followed by “UP TO 15% OFF”. Below it, add a large bold heading “PREPARE YOUR RIDE FOR ADVERSE CONDITIONS” and a short description underneath.
    
    Right side: Create a compact white promo-code card with a dark 2px border and rounded corners. Add “Enter promo code at checkout:” at the top. Below it, create a bordered horizontal promo-code field showing “WINTER15” on the left and a red COPY CODE action on the right. Add a red SHOP DEALS NOW button underneath.
    
    The Copy Code action must copy the promo code and temporarily display “Copied!”.
    
    Make all text, promo code, links, font family, font size, font weight, colors, backgrounds, borders, radius, button padding, section padding, spacing, column widths and alignment editable from the Shopify Theme Editor.
    
    On mobile, stack the left content and promo card vertically and make both full width. Keep all styling scoped only to this section.
    keep the discount code section to be functional
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promo-banner-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background }};
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px {{ block.settings.section_padding_horizontal }}px;
  }

  .ai-promo-banner__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.columns_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-promo-banner__left-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.left_column_width }}%;
  }

  .ai-promo-banner__badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: {{ block.settings.badge_gap }}px;
    margin-bottom: {{ block.settings.badge_margin_bottom }}px;
  }

  .ai-promo-banner__badge-label-{{ ai_gen_id }} {
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    font-family: {{ block.settings.badge_font.family }}, {{ block.settings.badge_font.fallback_families }};
    font-weight: {{ block.settings.badge_font.weight }};
    font-size: {{ block.settings.badge_font_size }}px;
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-promo-banner__badge-discount-{{ ai_gen_id }} {
    color: {{ block.settings.discount_text_color }};
    font-family: {{ block.settings.discount_font.family }}, {{ block.settings.discount_font.fallback_families }};
    font-weight: {{ block.settings.discount_font.weight }};
    font-size: {{ block.settings.discount_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-promo-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: 700;
    font-size: {{ block.settings.heading_font_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px 0;
  }

  .ai-promo-banner__description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_font_size }}px;
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  .ai-promo-banner__right-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.right_column_width }}%;
  }

  .ai-promo-banner__promo-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-promo-banner__card-label-{{ ai_gen_id }} {
    color: {{ block.settings.card_label_color }};
    font-family: {{ block.settings.card_label_font.family }}, {{ block.settings.card_label_font.fallback_families }};
    font-weight: {{ block.settings.card_label_font.weight }};
    font-size: {{ block.settings.card_label_font_size }}px;
    margin: 0 0 {{ block.settings.card_label_margin_bottom }}px 0;
  }

  .ai-promo-banner__promo-code-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    border: {{ block.settings.promo_field_border_width }}px solid {{ block.settings.promo_field_border_color }};
    border-radius: {{ block.settings.promo_field_border_radius }}px;
    padding: {{ block.settings.promo_field_padding }}px;
    margin-bottom: {{ block.settings.promo_field_margin_bottom }}px;
    background-color: {{ block.settings.promo_field_background }};
  }

  .ai-promo-banner__promo-code-{{ ai_gen_id }} {
    flex: 1;
    color: {{ block.settings.promo_code_color }};
    font-family: {{ block.settings.promo_code_font.family }}, {{ block.settings.promo_code_font.fallback_families }};
    font-weight: {{ block.settings.promo_code_font.weight }};
    font-size: {{ block.settings.promo_code_font_size }}px;
    margin: 0;
  }

  .ai-promo-banner__copy-button-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.copy_button_color }};
    font-family: {{ block.settings.copy_button_font.family }}, {{ block.settings.copy_button_font.fallback_families }};
    font-weight: {{ block.settings.copy_button_font.weight }};
    font-size: {{ block.settings.copy_button_font_size }}px;
    cursor: pointer;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
  }

  .ai-promo-banner__copy-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-promo-banner__shop-button-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.shop_button_background }};
    color: {{ block.settings.shop_button_color }};
    font-family: {{ block.settings.shop_button_font.family }}, {{ block.settings.shop_button_font.fallback_families }};
    font-weight: {{ block.settings.shop_button_font.weight }};
    font-size: {{ block.settings.shop_button_font_size }}px;
    padding: {{ block.settings.shop_button_padding_vertical }}px {{ block.settings.shop_button_padding_horizontal }}px;
    border-radius: {{ block.settings.shop_button_border_radius }}px;
    border: none;
    text-decoration: none;
    text-align: center;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-promo-banner__shop-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.shop_button_hover_background }};
    color: {{ block.settings.shop_button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-promo-banner__container-{{ ai_gen_id }} {
      flex-direction: {{ block.settings.mobile_layout }};
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-promo-banner__left-{{ ai_gen_id }},
    .ai-promo-banner__right-{{ ai_gen_id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .ai-promo-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_font_size }}px;
    }

    .ai-promo-banner__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_description_font_size }}px;
    }
  }
{% endstyle %}

<promo-banner-{{ ai_gen_id }} class="ai-promo-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promo-banner__container-{{ ai_gen_id }}">
    <div class="ai-promo-banner__left-{{ ai_gen_id }}">
      <div class="ai-promo-banner__badge-{{ ai_gen_id }}">
        <span class="ai-promo-banner__badge-label-{{ ai_gen_id }}">{{ block.settings.badge_text }}</span>
        <span class="ai-promo-banner__badge-discount-{{ ai_gen_id }}">{{ block.settings.discount_text }}</span>
      </div>
      <h2 class="ai-promo-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <p class="ai-promo-banner__description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
    </div>

    <div class="ai-promo-banner__right-{{ ai_gen_id }}">
      <div class="ai-promo-banner__promo-card-{{ ai_gen_id }}">
        <p class="ai-promo-banner__card-label-{{ ai_gen_id }}">{{ block.settings.card_label }}</p>
        
        <div class="ai-promo-banner__promo-code-wrapper-{{ ai_gen_id }}">
          <p class="ai-promo-banner__promo-code-{{ ai_gen_id }}" data-promo-code="{{ block.settings.promo_code }}">
            {{ block.settings.promo_code }}
          </p>
          <button 
            class="ai-promo-banner__copy-button-{{ ai_gen_id }}"
            data-copy-button
            aria-label="Copy promo code"
          >
            {{ block.settings.copy_button_text }}
          </button>
        </div>

        <a 
          href="{{ block.settings.shop_button_link }}" 
          class="ai-promo-banner__shop-button-{{ ai_gen_id }}"
        >
          {{ block.settings.shop_button_text }}
        </a>
      </div>
    </div>
  </div>
</promo-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class PromoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.copyButton = this.querySelector('[data-copy-button]');
        this.promoCodeElement = this.querySelector('[data-promo-code]');
        this.originalButtonText = this.copyButton.textContent;
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.copyButton.addEventListener('click', () => {
          const promoCode = this.promoCodeElement.getAttribute('data-promo-code');
          
          navigator.clipboard.writeText(promoCode).then(() => {
            this.copyButton.textContent = '{{ block.settings.copied_text }}';
            
            setTimeout(() => {
              this.copyButton.textContent = this.originalButtonText;
            }, 2000);
          }).catch(() => {
            const textArea = document.createElement('textarea');
            textArea.value = promoCode;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.select();
            
            try {
              document.execCommand('copy');
              this.copyButton.textContent = '{{ block.settings.copied_text }}';
              
              setTimeout(() => {
                this.copyButton.textContent = this.originalButtonText;
              }, 2000);
            } catch (err) {
              console.error('Failed to copy text');
            }
            
            document.body.removeChild(textArea);
          });
        });
      }
    }

    customElements.define('promo-banner-{{ ai_gen_id }}', PromoBanner{{ ai_gen_id }});
  })();
</script>

