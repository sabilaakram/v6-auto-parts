{% doc %}
  @prompt
    Generate an "Our Team" section for the About Us page: centered red eyebrow label + bold heading, then a row of team member photo cards (photo + name). On desktop, if there are more than the configured number of visible columns the row becomes a horizontally scrollable carousel with prev/next arrows; if there are fewer members than the column count it stays a static centered row with no scrolling/arrows. On mobile the row is always a swipeable/scrollable carousel regardless of member count. All fonts, sizes, colors and each member's photo/name/role must be editable from the theme editor for desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_team_image_class = 'ai-team__image-' | append: ai_gen_id %}

{% assign team_count = 0 %}
{% for i in (1..8) %}
  {% assign enabled_key = 'team_' | append: i | append: '_enabled' %}
  {% if block.settings[enabled_key] %}
    {% assign team_count = team_count | plus: 1 %}
  {% endif %}
{% endfor %}
{% assign is_desktop_carousel = false %}
{% if team_count > block.settings.columns_desktop %}
  {% assign is_desktop_carousel = true %}
{% endif %}

{% style %}
  .ai-team-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-team__container-{{ai_gen_id}} {
    width: {{ block.settings.container_width_percent }}%;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-team__header-{{ai_gen_id}} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.header_spacing_bottom }}px;
  }

  .ai-team__eyebrow-{{ai_gen_id}} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-style: {{ block.settings.eyebrow_font.style }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    text-transform: {{ block.settings.eyebrow_case }};
    margin: 0 0 {{ block.settings.eyebrow_spacing_bottom }}px 0;
    display: block;
  }

  .ai-team__heading-{{ai_gen_id}} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-team__row-{{ai_gen_id}} {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-team__track-{{ai_gen_id}} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    flex: 1 1 auto;
    min-width: 0;
    scroll-behavior: smooth;
  }

  .ai-team__track-{{ai_gen_id}}.is-static {
    justify-content: center;
    flex-wrap: wrap;
    overflow: visible;
  }

  .ai-team__track-{{ai_gen_id}}.is-carousel {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-team__track-{{ai_gen_id}}.is-carousel::-webkit-scrollbar {
    display: none;
  }

  .ai-team__card-{{ai_gen_id}} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.columns_desktop }});
    scroll-snap-align: start;
    text-align: center;
  }

  .ai-team__track-{{ai_gen_id}}.is-static .ai-team__card-{{ai_gen_id}} {
    flex: 0 0 auto;
    width: calc((100% - ({{ block.settings.columns_desktop }} - 1) * {{ block.settings.card_gap }}px) / {{ block.settings.columns_desktop }});
  }

  .ai-team__image-wrap-{{ai_gen_id}} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    overflow: hidden;
    background: #f1f1f1;
    margin: 0 0 {{ block.settings.name_spacing_top }}px 0;
    {% unless block.settings.image_aspect_ratio == 'auto' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endunless %}
  }

  .ai-team__image-{{ai_gen_id}} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-team__name-{{ai_gen_id}} {
    font-family: {{ block.settings.name_font.family }}, {{ block.settings.name_font.fallback_families }};
    font-weight: {{ block.settings.name_font.weight }};
    font-style: {{ block.settings.name_font.style }};
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    margin: 0;
  }

  .ai-team__role-{{ai_gen_id}} {
    font-family: {{ block.settings.role_font.family }}, {{ block.settings.role_font.fallback_families }};
    font-weight: {{ block.settings.role_font.weight }};
    font-style: {{ block.settings.role_font.style }};
    font-size: {{ block.settings.role_size }}px;
    color: {{ block.settings.role_color }};
    margin: 4px 0 0 0;
  }

  .ai-team__arrow-{{ai_gen_id}} {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.arrow_bg_color }};
    border: 1px solid {{ block.settings.arrow_border_color }};
    color: {{ block.settings.arrow_icon_color }};
    cursor: pointer;
    padding: 0;
  }

  .ai-team__arrow-{{ai_gen_id}} svg {
    width: 18px;
    height: 18px;
  }

  .ai-team__arrow-{{ai_gen_id}}[hidden] {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .ai-team__row-{{ai_gen_id}}:not(.is-carousel-desktop) .ai-team__arrow-{{ai_gen_id}} {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-team-{{ai_gen_id}} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-team__container-{{ai_gen_id}} {
      width: 100%;
    }

    .ai-team__eyebrow-{{ai_gen_id}} {
      font-size: {{ block.settings.eyebrow_size_mobile }}px;
    }

    .ai-team__heading-{{ai_gen_id}} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-team__track-{{ai_gen_id}} {
      gap: {{ block.settings.card_gap_mobile }}px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      flex-wrap: nowrap;
      justify-content: flex-start;
    }

    .ai-team__track-{{ai_gen_id}}::-webkit-scrollbar {
      display: none;
    }

    .ai-team__card-{{ai_gen_id}},
    .ai-team__track-{{ai_gen_id}}.is-static .ai-team__card-{{ai_gen_id}} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile }} - 1) * {{ block.settings.card_gap_mobile }}px) / {{ block.settings.columns_mobile }});
      width: auto;
    }

    .ai-team__name-{{ai_gen_id}} {
      font-size: {{ block.settings.name_size_mobile }}px;
    }

    .ai-team__role-{{ai_gen_id}} {
      font-size: {{ block.settings.role_size_mobile }}px;
    }

    .ai-team__arrow-{{ai_gen_id}} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-team-{{ai_gen_id}}">
  <div class="ai-team__container-{{ai_gen_id}}">
    <div class="ai-team__header-{{ai_gen_id}}">
      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-team__eyebrow-{{ai_gen_id}}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
      {% if block.settings.heading_text != blank %}
        <h2 class="ai-team__heading-{{ai_gen_id}}">{{ block.settings.heading_text }}</h2>
      {% endif %}
    </div>

    <ai-team-carousel-{{ai_gen_id}} class="ai-team__row-{{ai_gen_id}}{% if is_desktop_carousel %} is-carousel-desktop{% endif %}">
      <button type="button" class="ai-team__arrow-{{ai_gen_id}}" data-direction="prev" aria-label="Previous team members"{% unless is_desktop_carousel %} hidden{% endunless %}>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="ai-team__track-{{ai_gen_id}}{% if is_desktop_carousel %} is-carousel{% else %} is-static{% endif %}" data-team-track>
        {% for i in (1..8) %}
          {% assign enabled_key = 'team_' | append: i | append: '_enabled' %}
          {% assign image_key = 'team_' | append: i | append: '_image' %}
          {% assign name_key = 'team_' | append: i | append: '_name' %}
          {% assign role_key = 'team_' | append: i | append: '_role' %}
          {% if block.settings[enabled_key] %}
            <div class="ai-team__card-{{ai_gen_id}}">
              <div class="ai-team__image-wrap-{{ai_gen_id}}">
                {% if block.settings[image_key] %}
                  {{ block.settings[image_key] | image_url: width: 800 | image_tag: class: ai_team_image_class, alt: block.settings[name_key], loading: 'lazy', widths: '200,300,400,600,800' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: ai_team_image_class }}
                {% endif %}
              </div>
              {% if block.settings[name_key] != blank %}
                <p class="ai-team__name-{{ai_gen_id}}">{{ block.settings[name_key] }}</p>
              {% endif %}
              {% if block.settings[role_key] != blank %}
                <p class="ai-team__role-{{ai_gen_id}}">{{ block.settings[role_key] }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button type="button" class="ai-team__arrow-{{ai_gen_id}}" data-direction="next" aria-label="Next team members"{% unless is_desktop_carousel %} hidden{% endunless %}>
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </ai-team-carousel-{{ai_gen_id}}>
  </div>
</div>

<script>
  (function() {
    class AiTeamCarousel{{ai_gen_id}} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-team-track]');
        this.prevBtn = this.querySelector('[data-direction="prev"]');
        this.nextBtn = this.querySelector('[data-direction="next"]');
        if (!this.track || !this.prevBtn || !this.nextBtn) return;
        this.prevBtn.addEventListener('click', () => this.scrollByCard(-1));
        this.nextBtn.addEventListener('click', () => this.scrollByCard(1));
      }

      scrollByCard(direction) {
        const card = this.track.querySelector('[class*="ai-team__card-"]');
        if (!card) return;
        const gap = parseFloat(getComputedStyle(this.track).gap) || 0;
        const amount = (card.getBoundingClientRect().width + gap) * direction;
        this.track.scrollBy({ left: amount, behavior: 'smooth' });
      }
    }

    if (!customElements.get('ai-team-carousel-{{ai_gen_id}}')) {
      customElements.define('ai-team-carousel-{{ai_gen_id}}', AiTeamCarousel{{ai_gen_id}});
    }
  })();
</script>

