      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Icon background",
      "default": "#fdeaea"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#a50000"
    },
    {
      "type": "range",
      "id": "icon_circle_size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Icon circle size",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Title style"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Font",
      "default": "assistant_n7"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#121212"
