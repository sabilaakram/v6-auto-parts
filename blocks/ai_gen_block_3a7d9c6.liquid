{% doc %}
  @prompt
    Generate an info grid section for a Contact Us page: up to 4 columns, each with a small circular icon, a bold title, and a couple of lines of text (e.g. "Store Location" with two addresses, "Get In Touch With Us" with a phone and email, "Opening Hours" with two schedules). Thin vertical dividers between columns on desktop, stacking to one column on mobile. Every icon, title, text, font, size, color and spacing must be editable from the theme editor for desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-grid-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    border-top: 1px solid {{ block.settings.divider_color }};
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-info-grid__container-{{ai_gen_id}} {
    width: {{ block.settings.container_width_percent }}%;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-info-grid__item-{{ai_gen_id}} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.icon_gap }}px;
    padding-left: {{ block.settings.column_gap }}px;
    border-left: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
  }

  .ai-info-grid__item-{{ai_gen_id}}:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .ai-info-grid__icon-{{ai_gen_id}} {
    flex: 0 0 auto;
    width: {{ block.settings.icon_circle_size }}px;
    height: {{ block.settings.icon_circle_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    color: {{ block.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-info-grid__icon-{{ai_gen_id}} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: block;
  }

  .ai-info-grid__title-{{ai_gen_id}} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    text-transform: {{ block.settings.title_case }};
    margin: 0 0 {{ block.settings.title_spacing_bottom }}px 0;
  }

  .ai-info-grid__body-{{ai_gen_id}} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.body_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
  }

  .ai-info-grid__body-{{ai_gen_id}} p {
    margin: 0 0 {{ block.settings.body_paragraph_spacing }}px 0;
  }

  .ai-info-grid__body-{{ai_gen_id}} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-info-grid-{{ai_gen_id}} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-info-grid__container-{{ai_gen_id}} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-info-grid__item-{{ai_gen_id}} {
      padding-left: 0;
      border-left: 0;
      padding-top: {{ block.settings.column_gap_mobile }}px;
      border-top: {{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};
    }

    .ai-info-grid__item-{{ai_gen_id}}:first-child {
      padding-top: 0;
      border-top: 0;
    }

    .ai-info-grid__title-{{ai_gen_id}} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-info-grid__body-{{ai_gen_id}} {
      font-size: {{ block.settings.body_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-info-grid-{{ai_gen_id}}">
  <div class="ai-info-grid__container-{{ai_gen_id}}">
    {% for i in (1..4) %}
      {% assign enabled_key = 'item_' | append: i | append: '_enabled' %}
      {% assign icon_key = 'item_' | append: i | append: '_icon' %}
      {% assign title_key = 'item_' | append: i | append: '_title' %}
      {% assign body_key = 'item_' | append: i | append: '_body' %}
      {% if block.settings[enabled_key] %}
        <div class="ai-info-grid__item-{{ai_gen_id}}">
          <span class="ai-info-grid__icon-{{ai_gen_id}}">{{ block.settings[icon_key] }}</span>
          <div>
            {% if block.settings[title_key] != blank %}
              <p class="ai-info-grid__title-{{ai_gen_id}}">{{ block.settings[title_key] }}</p>
            {% endif %}
            {% if block.settings[body_key] != blank %}
              <div class="ai-info-grid__body-{{ai_gen_id}}">{{ block.settings[body_key] }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Contact info grid",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
