    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "checkbox",
      "id": "stat_2_enabled",
      "label": "Enable stat 2",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Number",
      "default": "65"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "People"
