    },
    {
      "type": "font_picker",
      "id": "number_font",
      "label": "Font",
      "default": "bebas_neue_n4"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Color",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 40,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 110
    },
    {
      "type": "range",
      "id": "number_size_mobile",
      "min": 24,
      "max": 110,
      "step": 2,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 56
    },
    {
      "type": "range",
