      "min": 0.7,
      "max": 1.3,
      "step": 0.1,
      "label": "Line height",
      "default": 0.9
    },
    {
      "type": "range",
      "id": "number_letter_spacing",
      "min": -8,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Letter spacing",
      "default": -2
    },
    {
      "type": "header",
