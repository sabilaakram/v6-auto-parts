      "default": "02"
    },
    {
      "type": "text",
      "id": "stat_4_label",
      "label": "Label",
      "default": "Offices"
    }
  ],
  "presets": [
    {
      "name": "Stats counter"
    }
  ]
}
{% endschema %}
