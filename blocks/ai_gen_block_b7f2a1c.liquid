{% doc %}
  @prompt
    Generate a stats/achievements counter section for the About Us page, matching a reference screenshot: a full-width red bar with four large bold black numbers (e.g. 98, 65, 10, 02), each with a small white label (Projects, People, Years, Offices) overlapping the number. Background color, all text, and all numbers must be easily editable from the theme editor. Must be fully responsive (4-across on desktop, 2x2 on mobile).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-stats-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-stats__container-{{ai_gen_id}} {
    width: {{ block.settings.container_width_percent }}%;
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.item_gap }}px;
  }

  .ai-stats__item-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .ai-stats__number-wrap-{{ai_gen_id}} {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }

  .ai-stats__number-{{ai_gen_id}} {
    font-family: {{ block.settings.number_font.family }}, {{ block.settings.number_font.fallback_families }};
    font-weight: {{ block.settings.number_font.weight }};
    font-style: {{ block.settings.number_font.style }};
    font-size: {{ block.settings.number_size }}px;
    line-height: {{ block.settings.number_line_height }};
    letter-spacing: {{ block.settings.number_letter_spacing }}px;
    color: {{ block.settings.number_color }};
    white-space: nowrap;
    display: block;
    margin: 0;
  }

  .ai-stats__label-{{ai_gen_id}} {
    position: absolute;
    top: {{ block.settings.label_top_position }}%;
    left: {{ block.settings.label_left_position }}%;
    transform: translate(-50%, -50%);
    font-family: {{ block.settings.label_font.family }}, {{ block.settings.label_font.fallback_families }};
    font-weight: {{ block.settings.label_font.weight }};
    font-style: {{ block.settings.label_font.style }};
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: {{ block.settings.label_case }};
    white-space: nowrap;
    z-index: 2;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-stats__container-{{ai_gen_id}} {
      gap: {{ block.settings.item_gap_tablet }}px;
    }

    .ai-stats__number-{{ai_gen_id}} {
      font-size: calc({{ block.settings.number_size }}px * 0.75);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-stats-{{ai_gen_id}} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-stats__container-{{ai_gen_id}} {
      width: 100%;
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
      gap: {{ block.settings.item_gap_mobile }}px;
    }

    .ai-stats__number-{{ai_gen_id}} {
      font-size: {{ block.settings.number_size_mobile }}px;
    }

    .ai-stats__label-{{ai_gen_id}} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }
  }

  @media screen and (max-width: 479px) {
    .ai-stats__number-{{ai_gen_id}} {
      font-size: calc({{ block.settings.number_size_mobile }}px * 0.8);
    }

    .ai-stats__label-{{ai_gen_id}} {
      font-size: calc({{ block.settings.label_size_mobile }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-stats-{{ai_gen_id}}">
  <div class="ai-stats__container-{{ai_gen_id}}">
    {% for i in (1..4) %}
      {% assign enabled_key = 'stat_' | append: i | append: '_enabled' %}
      {% assign number_key = 'stat_' | append: i | append: '_number' %}
      {% assign label_key = 'stat_' | append: i | append: '_label' %}
      {% assign is_enabled = block.settings[enabled_key] %}
      {% if is_enabled %}
        <div class="ai-stats__item-{{ai_gen_id}}">
          <div class="ai-stats__number-wrap-{{ai_gen_id}}">
            <span class="ai-stats__number-{{ai_gen_id}}">{{ block.settings[number_key] }}</span>
            <span class="ai-stats__label-{{ai_gen_id}}">{{ block.settings[label_key] }}</span>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
