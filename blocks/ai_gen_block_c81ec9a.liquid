{% doc %}
  @prompt
    generate a section with the 2 heading: main heading and sub heading (both of their styles, font family, size line height , color and case will be managed from the frontend) below the headings their will be different tabs, (similarly their styles, font family, size line height , color and case will be managed from the frontend) in every tabs their will be the grid (the number of rows and colum of the grid on mobile and desktop screens will be modified from frontend) of feature products shown from the selected collection, when that tab is hovered only the color of the text of that tab will be changed and their will be pointer appears below the text, all the other things will be same, and the background container will be of the 90% width, on the mobile screen the tabs will be in vertical, if more then 2.

    Rebuilt to match the "New Arrivals" product-tabs section from the V6 Auto Parts Figma file pixel-for-pixel: bordered product cards with star rating, sale price + discount badge, a wishlist toggle and a working "Add to cart" button wired into the theme cart drawer, fully responsive tab navigation and grid.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-tabs-{{ai_gen_id}} {
    display: block;
    width: 100%;
    padding: 40px 0;
  }

  .ai-featured-tabs__container-{{ai_gen_id}} {
    width: 90%;
    max-width: 1400px;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.container_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-featured-tabs__header-{{ai_gen_id}} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-featured-tabs__main-heading-{{ai_gen_id}} {
    font-family: {{ block.settings.main_heading_font.family }}, {{ block.settings.main_heading_font.fallback_families }};
    font-weight: {{ block.settings.main_heading_font.weight }};
    font-size: {{ block.settings.main_heading_size }}px;
    line-height: {{ block.settings.main_heading_line_height }};
    color: {{ block.settings.main_heading_color }};
    text-transform: {{ block.settings.main_heading_case }};
    letter-spacing: 0.18em;
    margin: 0 0 10px 0;
  }

  .ai-featured-tabs__sub-heading-{{ai_gen_id}} {
    font-family: {{ block.settings.sub_heading_font.family }}, {{ block.settings.sub_heading_font.fallback_families }};
    font-weight: {{ block.settings.sub_heading_font.weight }};
    font-size: {{ block.settings.sub_heading_size }}px;
    line-height: {{ block.settings.sub_heading_line_height }};
    color: {{ block.settings.sub_heading_color }};
    text-transform: {{ block.settings.sub_heading_case }};
    margin: 0;
  }

  .ai-featured-tabs__tabs-{{ai_gen_id}} {
    display: flex;
    gap: clamp(24px, 5vw, 100px);
    margin: 0 0 40px;
    padding: 0;
    justify-content: {{ block.settings.tabs_alignment }};
    align-items: stretch;
    list-style: none;
    border-bottom: 1px solid #d7d7d7;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-featured-tabs__tabs-{{ai_gen_id}}::-webkit-scrollbar {
    display: none;
  }

  .ai-featured-tabs__tab-{{ai_gen_id}} {
    position: relative;
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    font-family: {{ block.settings.tab_font.family }}, {{ block.settings.tab_font.fallback_families }};
    font-weight: {{ block.settings.tab_font.weight }};
    font-size: {{ block.settings.tab_size }}px;
    line-height: {{ block.settings.tab_line_height }};
    letter-spacing: 0.05em;
    color: {{ block.settings.tab_color }};
    text-transform: {{ block.settings.tab_case }};
    white-space: nowrap;
    padding: 20px 8px;
    margin-bottom: -1px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .ai-featured-tabs__tab-{{ai_gen_id}}:hover,
  .ai-featured-tabs__tab-{{ai_gen_id}}.active {
    color: {{ block.settings.tab_hover_color }};
  }

  .ai-featured-tabs__tab-{{ai_gen_id}}.active {
    border-bottom-color: {{ block.settings.tab_hover_color }};
  }

  .ai-featured-tabs__content-{{ai_gen_id}} {
    display: none;
  }

  .ai-featured-tabs__content-{{ai_gen_id}}.active {
    display: block;
    animation: ai-featured-tabs-fade-{{ai_gen_id}} 0.35s ease;
  }

  @keyframes ai-featured-tabs-fade-{{ai_gen_id}} {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ai-featured-tabs__grid-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-featured-tabs__card-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid rgba(202, 38, 41, 0.22);
    border-radius: {{ block.settings.product_image_radius | plus: 2 }}px;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }

  .ai-featured-tabs__card-{{ai_gen_id}}:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
  }

  .ai-featured-tabs__thumb-{{ai_gen_id}} {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    border-bottom: 2px solid #ffffff;
  }

  .ai-featured-tabs__thumb-{{ai_gen_id}} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .ai-featured-tabs__card-{{ai_gen_id}}:hover .ai-featured-tabs__thumb-{{ai_gen_id}} img {
    transform: scale(1.04);
  }

  .ai-featured-tabs__badge-{{ai_gen_id}} {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 2;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-family: {{ block.settings.tab_font.family }}, {{ block.settings.tab_font.fallback_families }};
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 10px 2px 10px 2px;
  }

  .ai-featured-tabs__wishlist-{{ai_gen_id}} {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #d7d7d7;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  .ai-featured-tabs__card-{{ai_gen_id}}:hover .ai-featured-tabs__wishlist-{{ai_gen_id}},
  .ai-featured-tabs__wishlist-{{ai_gen_id}}:focus-visible,
  .ai-featured-tabs__wishlist-{{ai_gen_id}}.is-active {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-featured-tabs__wishlist-{{ai_gen_id}} svg {
    width: 18px;
    height: 18px;
    fill: #686868;
    transition: fill 0.2s ease;
  }

  .ai-featured-tabs__wishlist-{{ai_gen_id}}.is-active svg {
    fill: {{ block.settings.accent_color }};
  }

  .ai-featured-tabs__body-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    gap: 16px;
    padding: 16px 20px 20px;
  }

  .ai-featured-tabs__title-{{ai_gen_id}} {
    margin: 0;
    font-family: Inter, sans-serif;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.35;
    color: #111111;
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }

  .ai-featured-tabs__card-{{ai_gen_id}}:hover .ai-featured-tabs__title-{{ai_gen_id}} {
    color: {{ block.settings.accent_color }};
  }

  .ai-featured-tabs__rating-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ai-featured-tabs__stars-{{ai_gen_id}} {
    position: relative;
    display: inline-flex;
    line-height: 0;
  }

  .ai-featured-tabs__stars-track-{{ai_gen_id}},
  .ai-featured-tabs__stars-fill-{{ai_gen_id}} {
    display: flex;
    gap: 2px;
  }

  .ai-featured-tabs__stars-track-{{ai_gen_id}} svg {
    width: 16px;
    height: 16px;
    fill: #e2e2e2;
  }

  .ai-featured-tabs__stars-fill-{{ai_gen_id}} {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .ai-featured-tabs__stars-fill-{{ai_gen_id}} svg {
    width: 16px;
    height: 16px;
    fill: #f0a911;
    flex: 0 0 16px;
  }

  .ai-featured-tabs__rating-count-{{ai_gen_id}} {
    font-family: Inter, sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #868686;
  }

  .ai-featured-tabs__footer-{{ai_gen_id}} {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-featured-tabs__price-{{ai_gen_id}} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-featured-tabs__price-current-{{ai_gen_id}} {
    font-family: Inter, sans-serif;
    font-size: 20px;
    color: #111111;
  }

  .ai-featured-tabs__price-{{ai_gen_id}}.has-sale .ai-featured-tabs__price-current-{{ai_gen_id}} {
    color: {{ block.settings.accent_color }};
    font-weight: 600;
  }

  .ai-featured-tabs__price-compare-{{ai_gen_id}} {
    font-family: Inter, sans-serif;
    font-size: 15px;
    color: #868686;
    text-decoration: line-through;
  }

  .ai-featured-tabs__cta-{{ai_gen_id}} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 24px;
    border: none;
    border-radius: 4px;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-family: Inter, sans-serif;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .ai-featured-tabs__cta-{{ai_gen_id}}:hover {
    background: #111111;
  }

  .ai-featured-tabs__cta-{{ai_gen_id}}[aria-disabled='true'],
  .ai-featured-tabs__cta-{{ai_gen_id}}:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  .ai-featured-tabs__cta-{{ai_gen_id}} .loading__spinner {
    width: 16px;
    height: 16px;
  }

  .ai-featured-tabs__cta-{{ai_gen_id}} .loading__spinner svg {
    width: 100%;
    height: 100%;
  }

  .ai-featured-tabs__empty-{{ai_gen_id}} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-style: italic;
    grid-column: 1 / -1;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-tabs__container-{{ai_gen_id}} {
      width: 94%;
    }

    .ai-featured-tabs__tabs-{{ai_gen_id}} {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-tabs__header-{{ai_gen_id}} {
      margin-bottom: 28px;
    }

    .ai-featured-tabs__tabs-{{ai_gen_id}} {
      margin-bottom: 28px;
      flex-direction: {{ block.settings.mobile_tabs_layout }};
    }

    {% if block.settings.mobile_tabs_layout == 'column' %}
      .ai-featured-tabs__tabs-{{ai_gen_id}} {
        border-bottom: none;
        align-items: stretch;
      }

      .ai-featured-tabs__tab-{{ai_gen_id}} {
        width: 100%;
        text-align: center;
        border-bottom: 1px solid #d7d7d7;
        padding: 14px 8px;
      }

      .ai-featured-tabs__tab-{{ai_gen_id}}.active {
        border-bottom: 3px solid {{ block.settings.tab_hover_color }};
      }
    {% endif %}

    .ai-featured-tabs__grid-{{ai_gen_id}} {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
      gap: {{ block.settings.grid_gap | at_most: 16 }}px;
    }

    .ai-featured-tabs__body-{{ai_gen_id}} {
      padding: 12px 14px 14px;
      gap: 10px;
    }

    .ai-featured-tabs__title-{{ai_gen_id}} {
      font-size: 15px;
    }

    .ai-featured-tabs__price-current-{{ai_gen_id}} {
      font-size: 16px;
    }

    .ai-featured-tabs__cta-{{ai_gen_id}} {
      padding: 10px 14px;
      font-size: 13px;
    }

    .ai-featured-tabs__wishlist-{{ai_gen_id}} {
      opacity: 1;
      transform: none;
      width: 32px;
      height: 32px;
    }

    .ai-featured-tabs__main-heading-{{ai_gen_id}} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.8);
    }

    .ai-featured-tabs__sub-heading-{{ai_gen_id}} {
      font-size: calc({{ block.settings.sub_heading_size }}px * 0.72);
    }

    .ai-featured-tabs__tab-{{ai_gen_id}} {
      font-size: calc({{ block.settings.tab_size }}px * 0.75);
    }
  }

  @media screen and (max-width: 479px) {
    {% if block.settings.mobile_columns > 1 %}
      .ai-featured-tabs__grid-{{ai_gen_id}} {
        grid-template-columns: 1fr;
      }
    {% endif %}

    .ai-featured-tabs__footer-{{ai_gen_id}} {
      align-items: center;
    }
  }
{% endstyle %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<featured-tabs-{{ai_gen_id}} class="ai-featured-tabs-{{ai_gen_id}}" {{ block.shopify_attributes }}>
  <div class="ai-featured-tabs__container-{{ai_gen_id}}">
    <div class="ai-featured-tabs__header-{{ai_gen_id}}">
      {% if block.settings.main_heading != blank %}
        <h2 class="ai-featured-tabs__main-heading-{{ai_gen_id}}">{{ block.settings.main_heading }}</h2>
      {% endif %}
      {% if block.settings.sub_heading != blank %}
        <p class="ai-featured-tabs__sub-heading-{{ai_gen_id}}">{{ block.settings.sub_heading }}</p>
      {% endif %}
    </div>

    <div class="ai-featured-tabs__tabs-{{ai_gen_id}}" role="tablist">
      {% for i in (1..5) %}
        {% liquid
          assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
          assign tab_title_key = 'tab_' | append: i | append: '_title'
          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_title = block.settings[tab_title_key]
        %}
        {% if tab_enabled and tab_title != blank %}
          <button
            type="button"
            id="tab-label-{{ ai_gen_id }}-{{ i }}"
            class="ai-featured-tabs__tab-{{ai_gen_id}}{% if forloop.first %} active{% endif %}"
            data-tab="tab-{{ i }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="tab-panel-{{ ai_gen_id }}-{{ i }}"
          >
            {{ tab_title }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    {% for i in (1..5) %}
      {% liquid
        assign tab_enabled_key = 'tab_' | append: i | append: '_enabled'
        assign collection_key = 'tab_' | append: i | append: '_collection'
        assign products_limit_key = 'tab_' | append: i | append: '_products_limit'
        assign tab_enabled = block.settings[tab_enabled_key]
        assign collection = block.settings[collection_key]
        assign products_limit = block.settings[products_limit_key]
      %}
      {% if tab_enabled %}
        <div
          id="tab-panel-{{ ai_gen_id }}-{{ i }}"
          class="ai-featured-tabs__content-{{ai_gen_id}}{% if forloop.first %} active{% endif %}"
          data-content="tab-{{ i }}"
          role="tabpanel"
          aria-labelledby="tab-label-{{ ai_gen_id }}-{{ i }}"
        >
          {% if collection != blank and collection.products.size > 0 %}
            <div class="ai-featured-tabs__grid-{{ai_gen_id}}">
              {% for product in collection.products limit: products_limit %}
                {% liquid
                  assign on_sale = false
                  if product.compare_at_price > product.price
                    assign on_sale = true
                    assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                  endif
                  assign rating = product.metafields.reviews.rating.value
                  assign rating_count = product.metafields.reviews.rating_count
                  assign variant = product.selected_or_first_available_variant
                %}
                <div class="ai-featured-tabs__card-{{ai_gen_id}}">
                  <div class="ai-featured-tabs__thumb-{{ai_gen_id}}">
                    {% if on_sale %}
                      <span class="ai-featured-tabs__badge-{{ai_gen_id}}">-{{ discount_percent }}%</span>
                    {% endif %}

                    {% if block.settings.show_wishlist %}
                      <button
                        type="button"
                        class="ai-featured-tabs__wishlist-{{ai_gen_id}}"
                        data-wishlist-toggle
                        data-product-id="{{ product.id }}"
                        aria-label="Add to wishlist"
                      >
                        {{ 'icon-heart.svg' | inline_asset_content }}
                      </button>
                    {% endif %}

                    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                      {% if product.featured_image %}
                        <img
                          src="{{ product.featured_image | image_url: width: 700 }}"
                          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 700 }} 700w, {{ product.featured_image | image_url: width: 1000 }} 1000w"
                          sizes="(min-width: 990px) 25vw, (min-width: 750px) 40vw, 90vw"
                          alt="{{ product.featured_image.alt | escape }}"
                          loading="lazy"
                          width="{{ product.featured_image.width }}"
                          height="{{ product.featured_image.height }}"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag }}
                      {% endif %}
                    </a>
                  </div>

                  <div class="ai-featured-tabs__body-{{ai_gen_id}}">
                    <a href="{{ product.url }}" class="ai-featured-tabs__title-{{ai_gen_id}}">{{ product.title }}</a>

                    {% if block.settings.show_rating and rating != blank %}
                      <div class="ai-featured-tabs__rating-{{ai_gen_id}}">
                        <span class="ai-featured-tabs__stars-{{ai_gen_id}}" aria-hidden="true">
                          <span class="ai-featured-tabs__stars-track-{{ai_gen_id}}">
                            {% for star in (1..5) %}{{ 'icon-star.svg' | inline_asset_content }}{% endfor %}
                          </span>
                          <span class="ai-featured-tabs__stars-fill-{{ai_gen_id}}" style="width: {{ rating | times: 20.0 | at_most: 100 }}%;">
                            {% for star in (1..5) %}{{ 'icon-star.svg' | inline_asset_content }}{% endfor %}
                          </span>
                        </span>
                        {% if rating_count != blank %}
                          <span class="ai-featured-tabs__rating-count-{{ai_gen_id}}">({{ rating_count }})</span>
                        {% endif %}
                      </div>
                    {% endif %}

                    <div class="ai-featured-tabs__footer-{{ai_gen_id}}">
                      <div class="ai-featured-tabs__price-{{ai_gen_id}}{% if on_sale %} has-sale{% endif %}">
                        {% if on_sale %}
                          <span class="ai-featured-tabs__price-compare-{{ai_gen_id}}">{{ product.compare_at_price | money }}</span>
                        {% endif %}
                        <span class="ai-featured-tabs__price-current-{{ai_gen_id}}">{{ product.price | money }}</span>
                      </div>

                      {% if block.settings.enable_add_to_cart %}
                        {% if product.has_only_default_variant %}
                          <product-form data-hide-errors="true">
                            {% form 'product', product %}
                              <input type="hidden" name="id" value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                              <button
                                type="submit"
                                class="ai-featured-tabs__cta-{{ai_gen_id}}"
                                {% unless variant.available %}disabled{% endunless %}
                              >
                                <span>
                                  {% if variant.available %}
                                    {{ 'products.product.add_to_cart' | t }}
                                  {% else %}
                                    {{ 'products.product.sold_out' | t }}
                                  {% endif %}
                                </span>
                                {% render 'loading-spinner' %}
                              </button>
                            {% endform %}
                          </product-form>
                        {% else %}
                          <a href="{{ product.url }}" class="ai-featured-tabs__cta-{{ai_gen_id}}">
                            {{ 'products.product.choose_options' | t }}
                          </a>
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-featured-tabs__empty-{{ai_gen_id}}">
              Next, select a collection for this tab
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</featured-tabs-{{ai_gen_id}}>

<script>
  (function() {
    class FeaturedTabs{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-featured-tabs__tab-{{ai_gen_id}}');
        this.contents = this.querySelectorAll('.ai-featured-tabs__content-{{ai_gen_id}}');
        this.setupEventListeners();
        this.setupWishlist();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetTab = tab.getAttribute('data-tab');

            this.tabs.forEach((t) => {
              t.classList.remove('active');
              t.setAttribute('aria-selected', 'false');
            });
            this.contents.forEach((c) => c.classList.remove('active'));

            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            const targetContent = this.querySelector(`[data-content="${targetTab}"]`);
            if (targetContent) {
              targetContent.classList.add('active');
            }
          });
        });
      }

      setupWishlist() {
        let saved = [];
        try {
          saved = JSON.parse(localStorage.getItem('v6-wishlist') || '[]');
        } catch (e) {
          saved = [];
        }

        this.querySelectorAll('[data-wishlist-toggle]').forEach((button) => {
          const id = button.getAttribute('data-product-id');
          if (saved.includes(id)) button.classList.add('is-active');

          button.addEventListener('click', () => {
            button.classList.toggle('is-active');
            const isActive = button.classList.contains('is-active');
            let list = [];
            try {
              list = JSON.parse(localStorage.getItem('v6-wishlist') || '[]');
            } catch (e) {
              list = [];
            }
            if (isActive && !list.includes(id)) list.push(id);
            if (!isActive) list = list.filter((item) => item !== id);
            try {
              localStorage.setItem('v6-wishlist', JSON.stringify(list));
            } catch (e) {
              /* storage unavailable */
            }
          });
        });
      }
    }

    if (!customElements.get('featured-tabs-{{ai_gen_id}}')) {
      customElements.define('featured-tabs-{{ai_gen_id}}', FeaturedTabs{{ai_gen_id}});
    }
  })();
</script>

