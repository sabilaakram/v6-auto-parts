{% doc %}
  @prompt
    Vehicle parts finder widget, white background, two tabs: "Vehicle Reg" (first, active by
    default) and "Search by Parts". Both are plain GET forms that open a results page:
    Vehicle Reg -> the reg results page (default /pages/vehicle-parts?reg=..., page template
    templates/page.vehicle-parts.json -> sections/vehicle-parts-results.liquid, which does the
    DVLA lookup + parts shortlist); Search by Parts -> native Shopify /search?q=.
    Used on the homepage and the product page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .vf-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: none;
    padding: {{ block.settings.padding_vertical }}px 20px !important;
    border-top: none;
    box-shadow: none;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
  }

  .vf-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .vf-heading-{{ ai_gen_id }} {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    color: {{ block.settings.heading_color }};
    text-align: center;
    text-transform: uppercase;
    margin: 0 0 24px;
  }

  .vf-bar-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .vf-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .vf-tab-{{ ai_gen_id }} {
    position: relative;
    border: none;
    cursor: pointer;
    padding: 12px 24px 12px 20px;
    font-family: Inter, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%);
    background: {{ block.settings.dropdown_bg_color }};
    color: {{ block.settings.body_text_color }};
    box-shadow: inset 0 0 0 1px #e0e0e0;
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .vf-tab-{{ ai_gen_id }}.is-active {
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    box-shadow: none;
  }

  .vf-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .vf-panel-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    gap: 6px;
  }

  .vf-panel-{{ ai_gen_id }}.is-active {
    display: flex;
  }

  .vf-panel-label-{{ ai_gen_id }} {
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.note_text_color }};
    white-space: nowrap;
  }

  .vf-cluster-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vf-search-input-wrap-{{ ai_gen_id }} {
    position: relative;
    flex: 1 1 240px;
    min-width: 200px;
  }

  .vf-search-icon-{{ ai_gen_id }} {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #777;
    pointer-events: none;
  }

  .vf-search-input-{{ ai_gen_id }} {
    width: 100%;
    height: 46px;
    border: none;
    border-radius: 4px;
    padding: 0 14px 0 40px;
    font-family: Inter, sans-serif;
    font-size: 14px;
    color: #111111;
    background: {{ block.settings.search_input_bg_color }};
  }

  .vf-search-input-{{ ai_gen_id }}::placeholder {
    color: #999;
  }

  .vf-reg-input-wrap-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    height: 46px;
    flex: 1 1 220px;
    min-width: 180px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid #000000;
  }

  .vf-reg-badge-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 32px;
    background: #003399;
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.1;
    padding: 4px 0;
  }

  .vf-reg-input-{{ ai_gen_id }} {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    background: #ffd400;
    color: #111111;
    font-family: 'Charles Wright', Arial, sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 8px 10px;
  }

  .vf-reg-input-{{ ai_gen_id }}::placeholder {
    color: #8a7a00;
    opacity: 1;
  }

  .vf-btn-{{ ai_gen_id }} {
    flex: 0 0 auto;
    border: none;
    cursor: pointer;
    padding: 0 26px 0 22px;
    height: 46px;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-family: Inter, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%);
    transition: background-color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vf-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.accent_hover_color }};
  }

  .vf-note-{{ ai_gen_id }} {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 12px;
    color: {{ block.settings.note_text_color }};
  }

  @media screen and (max-width: 749px) {
    .vf-{{ ai_gen_id }} {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    .vf-heading-{{ ai_gen_id }} {
      font-size: 28px;
      line-height: 1.3;
    }

    .vf-tabs-{{ ai_gen_id }} {
      width: 100%;
    }

    .vf-tab-{{ ai_gen_id }} {
      flex: 1 1 0;
      text-align: center;
      clip-path: none;
      border-radius: 4px;
      padding: 12px 10px;
    }

    .vf-cluster-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .vf-search-input-wrap-{{ ai_gen_id }},
    .vf-reg-input-wrap-{{ ai_gen_id }} {
      flex: 0 0 auto;
      width: 100%;
      min-width: 0;
    }

    .vf-btn-{{ ai_gen_id }} {
      clip-path: none;
      border-radius: 4px;
      width: 100%;
      height: auto;
      padding: 14px;
    }
  }
{% endstyle %}

{%- liquid
  assign reg_results_url = block.settings.reg_results_url | strip
  if reg_results_url == blank
    assign reg_results_url = '/pages/vehicle-parts'
  endif
-%}

<vehicle-finder-{{ ai_gen_id }} class="vf-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="vf-inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="vf-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div>
    {% endif %}

    <div class="vf-bar-{{ ai_gen_id }}">
      <div class="vf-tabs-{{ ai_gen_id }}" role="tablist">
        <button type="button" class="vf-tab-{{ ai_gen_id }} is-active" data-vf-tab="reg" role="tab" aria-selected="true">
          {{ block.settings.reg_tab_label | default: 'Vehicle Reg' }}
        </button>
        <button type="button" class="vf-tab-{{ ai_gen_id }}" data-vf-tab="search" role="tab" aria-selected="false">
          {{ block.settings.search_tab_label | default: 'Search by Parts' }}
        </button>
      </div>

      <div class="vf-content-{{ ai_gen_id }}">
        {%- comment -%} Vehicle Reg: opens the reg results page, which does the DVLA lookup + parts shortlist {%- endcomment -%}
        <div class="vf-panel-{{ ai_gen_id }} is-active" data-vf-panel="reg" role="tabpanel">
          {% if block.settings.reg_field_label != blank %}
            <span class="vf-panel-label-{{ ai_gen_id }}">{{ block.settings.reg_field_label }}</span>
          {% endif %}
          <form action="{{ reg_results_url | escape }}" method="get" class="vf-cluster-{{ ai_gen_id }}" data-vf-reg-form>
            <div class="vf-reg-input-wrap-{{ ai_gen_id }}">
              <span class="vf-reg-badge-{{ ai_gen_id }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="10" fill="#FFD700"/>
                </svg>
                UK
              </span>
              <input
                type="text"
                name="reg"
                class="vf-reg-input-{{ ai_gen_id }}"
                data-vf-reg-input
                maxlength="8"
                required
                autocomplete="off"
                autocapitalize="characters"
                aria-label="Vehicle registration number"
                placeholder="{{ block.settings.reg_placeholder }}"
              >
            </div>
            <button type="submit" class="vf-btn-{{ ai_gen_id }}">{{ block.settings.reg_button_label }}</button>
          </form>
          {% if block.settings.reg_note != blank %}
            <p class="vf-note-{{ ai_gen_id }}">{{ block.settings.reg_note }}</p>
          {% endif %}
        </div>

        {%- comment -%} Search by Parts: plain native Shopify search {%- endcomment -%}
        <div class="vf-panel-{{ ai_gen_id }}" data-vf-panel="search" role="tabpanel">
          {% if block.settings.search_label != blank %}
            <span class="vf-panel-label-{{ ai_gen_id }}">{{ block.settings.search_label }}</span>
          {% endif %}
          <form action="{{ routes.search_url }}" method="get" class="vf-cluster-{{ ai_gen_id }}" role="search">
            <input type="hidden" name="type" value="product">
            <div class="vf-search-input-wrap-{{ ai_gen_id }}">
              <svg class="vf-search-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="M21 21l-4.35-4.35"></path>
              </svg>
              <input
                type="search"
                name="q"
                required
                class="vf-search-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.search_placeholder }}"
                aria-label="Search for parts"
              >
            </div>
            <button type="submit" class="vf-btn-{{ ai_gen_id }}">{{ block.settings.find_button_label }}</button>
          </form>
          {% if block.settings.search_note != blank %}
            <p class="vf-note-{{ ai_gen_id }}">{{ block.settings.search_note }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</vehicle-finder-{{ ai_gen_id }}>

<script>
  (function () {
    class VehicleFinder{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.tabs = this.querySelectorAll('[data-vf-tab]');
        this.panels = this.querySelectorAll('[data-vf-panel]');
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => this.switchTab(tab.dataset.vfTab));
        });

        const regInput = this.querySelector('[data-vf-reg-input]');
        const regForm = this.querySelector('[data-vf-reg-form]');
        if (regInput && regForm) {
          regInput.addEventListener('input', () => {
            regInput.value = regInput.value.toUpperCase();
          });
          // Send a clean reg (no spaces/symbols) to the results page.
          regForm.addEventListener('submit', () => {
            regInput.value = regInput.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
          });
        }
      }

      switchTab(name) {
        this.tabs.forEach((tab) => {
          const active = tab.dataset.vfTab === name;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        this.panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.vfPanel === name));
      }
    }

    if (!customElements.get('vehicle-finder-{{ ai_gen_id }}')) {
      customElements.define('vehicle-finder-{{ ai_gen_id }}', VehicleFinder{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Vehicle parts finder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Parts For Your Vehicle"
    },
    {
      "type": "text",
      "id": "reg_tab_label",
      "label": "Vehicle reg tab label (first tab)",
      "default": "Vehicle Reg"
    },
    {
      "type": "text",
      "id": "search_tab_label",
      "label": "Search tab label (second tab)",
      "default": "Search by Parts"
    },
    {
      "type": "header",
      "content": "Vehicle reg"
    },
    {
      "type": "text",
      "id": "reg_field_label",
      "label": "Label above reg input",
      "default": "Find vehicle by Reg:"
    },
    {
      "type": "text",
      "id": "reg_placeholder",
      "label": "Reg input placeholder",
      "default": "YY26 ABC"
    },
    {
      "type": "text",
      "id": "reg_button_label",
      "label": "Reg button label",
      "default": "Find Parts"
    },
    {
      "type": "text",
      "id": "reg_note",
      "label": "Reg helper note",
      "default": "Enter your number plate to see parts matched to your vehicle's make, year, engine and fuel.",
      "info": "Leave blank to hide."
    },
    {
      "type": "text",
      "id": "reg_results_url",
      "label": "Reg results page URL",
      "default": "/pages/vehicle-parts",
      "info": "The page using the \"vehicle-parts\" page template. The DVLA lookup service URL is set on that page's section."
    },
    {
      "type": "header",
      "content": "Search by Parts"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Label above search bar",
      "info": "Optional small label shown above the input, e.g. \"What are you looking for?\". Leave blank to hide."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search input placeholder",
      "default": "Search for parts..."
    },
    {
      "type": "color",
      "id": "search_input_bg_color",
      "label": "Search field background",
      "default": "#fbe4e4"
    },
    {
      "type": "text",
      "id": "find_button_label",
      "label": "Search button label",
      "default": "Find Parts"
    },
    {
      "type": "text",
      "id": "search_note",
      "label": "Helper note below search (optional)"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 14
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#a50000"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Inactive tab text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "note_text_color",
      "label": "Label & note text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "dropdown_bg_color",
      "label": "Inactive tab background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (buttons, active tab)",
      "default": "#a50000"
    },
    {
      "type": "color",
      "id": "accent_hover_color",
      "label": "Accent hover color",
      "default": "#7a0000"
    }
  ],
  "presets": [
    {
      "name": "Vehicle parts finder"
    }
  ]
}
{% endschema %}
