{% doc %}
  @prompt
    Vehicle parts finder widget, white background, stacked two-row layout: a tab row
    (Search by Parts / Reg Lookup) on top, then the active tab's full content -- icon/badge
    + input + button -- on its own row below, matching a reference design. Search by Parts
    is a plain native Shopify /search?q= form (no JS needed). Reg Lookup
    is a UK number-plate style input; its DVLA API call is stubbed until a server-side
    proxy + API key exist (DVLA's API cannot be called from the browser directly) -- until
    then, submitting navigates to /search?q=<reg> so the tab stays functional rather than
    a dead end. The old Make/Model/Year dropdown-based search has been removed entirely
    per request -- keyword search is now the only "manual" search mode.
    Used on the homepage and, with page_context: 'product', on the product page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .vf-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 20px;
    border-top: 3px solid {{ block.settings.accent_color }};
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    position: relative;
    z-index: 1;
  }

  .vf-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .vf-heading-{{ ai_gen_id }} {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: {{ block.settings.heading_color }};
    text-align: center;
    margin: 0 0 16px;
    letter-spacing: 0.02em;
  }

  .vf-bar-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
  }

  .vf-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .vf-tab-{{ ai_gen_id }} {
    position: relative;
    border: none;
    cursor: pointer;
    padding: 12px 24px 12px 20px;
    font-family: Inter, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%);
    background: {{ block.settings.dropdown_bg_color }};
    color: {{ block.settings.body_text_color }};
    transition: background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .vf-tab-{{ ai_gen_id }}.is-active {
    background: {{ block.settings.accent_color }};
    color: #ffffff;
  }

  .vf-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .vf-panel-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    gap: 6px;
  }

  .vf-panel-{{ ai_gen_id }}.is-active {
    display: flex;
  }

  .vf-panel-label-{{ ai_gen_id }} {
    font-family: Inter, sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.note_text_color }};
    white-space: nowrap;
  }

  .vf-cluster-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vf-search-input-wrap-{{ ai_gen_id }} {
    position: relative;
    flex: 1 1 240px;
    min-width: 200px;
  }

  .vf-search-icon-{{ ai_gen_id }} {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #777;
    pointer-events: none;
  }

  .vf-search-input-{{ ai_gen_id }} {
    width: 100%;
    height: 46px;
    border: none;
    border-radius: 4px;
    padding: 0 14px 0 40px;
    font-family: Inter, sans-serif;
    font-size: 14px;
    color: #111111;
    background: {{ block.settings.search_input_bg_color }};
  }

  .vf-search-input-{{ ai_gen_id }}::placeholder {
    color: #999;
  }

  .vf-reg-input-wrap-{{ ai_gen_id }} {
    display: flex;
    align-items: stretch;
    flex: 1 1 220px;
    min-width: 180px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid #000000;
  }

  .vf-reg-badge-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 32px;
    background: #003399;
    color: #ffffff;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.1;
    padding: 4px 0;
  }

  .vf-reg-input-{{ ai_gen_id }} {
    flex: 1 1 auto;
    border: none;
    background: #ffd400;
    color: #111111;
    font-family: 'Charles Wright', Arial, sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 8px 10px;
  }

  .vf-reg-input-{{ ai_gen_id }}::placeholder {
    color: #8a7a00;
    opacity: 1;
  }

  .vf-btn-{{ ai_gen_id }} {
    flex: 0 0 auto;
    border: none;
    cursor: pointer;
    padding: 0 26px 0 22px;
    height: 46px;
    background: {{ block.settings.accent_color }};
    color: #ffffff;
    font-family: Inter, sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    clip-path: polygon(0 0, 88% 0, 100% 50%, 88% 100%, 0 100%);
    transition: background-color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vf-btn-{{ ai_gen_id }}:hover {
    background: {{ block.settings.accent_hover_color }};
  }

  .vf-note-{{ ai_gen_id }} {
    margin: 0;
    font-family: Inter, sans-serif;
    font-size: 12px;
    color: {{ block.settings.note_text_color }};
  }

  @media screen and (max-width: 749px) {
    .vf-bar-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .vf-tabs-{{ ai_gen_id }} {
      width: 100%;
    }

    .vf-tab-{{ ai_gen_id }} {
      flex: 1 1 auto;
      text-align: center;
      clip-path: none;
      border-radius: 4px;
    }

    .vf-cluster-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .vf-btn-{{ ai_gen_id }} {
      clip-path: none;
      border-radius: 4px;
      width: 100%;
      height: auto;
      padding: 14px;
    }
  }
{% endstyle %}

<vehicle-finder-{{ ai_gen_id }} class="vf-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="vf-inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="vf-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div>
    {% endif %}

    <div class="vf-bar-{{ ai_gen_id }}">
      <div class="vf-tabs-{{ ai_gen_id }}">
        <button type="button" class="vf-tab-{{ ai_gen_id }} is-active" data-vf-tab="search">
          {{ block.settings.search_tab_label }}
        </button>
        <button type="button" class="vf-tab-{{ ai_gen_id }}" data-vf-tab="reg">
          {{ block.settings.reg_tab_label }}
        </button>
      </div>

      <div class="vf-content-{{ ai_gen_id }}">
        {%- comment -%} Search by Parts: plain native Shopify search, no JS required to function {%- endcomment -%}
        <div class="vf-panel-{{ ai_gen_id }} is-active" data-vf-panel="search">
          {% if block.settings.search_label != blank %}
            <span class="vf-panel-label-{{ ai_gen_id }}">{{ block.settings.search_label }}</span>
          {% endif %}
          <form action="{{ routes.search_url }}" method="get" class="vf-cluster-{{ ai_gen_id }}" role="search">
            <input type="hidden" name="type" value="product">
            <div class="vf-search-input-wrap-{{ ai_gen_id }}">
              <svg class="vf-search-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="M21 21l-4.35-4.35"></path>
              </svg>
              <input
                type="search"
                name="q"
                class="vf-search-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.search_placeholder }}"
                aria-label="Search for parts"
              >
            </div>
            <button type="submit" class="vf-btn-{{ ai_gen_id }}">{{ block.settings.find_button_label }}</button>
          </form>
          {% if block.settings.search_note != blank %}
            <p class="vf-note-{{ ai_gen_id }}">{{ block.settings.search_note }}</p>
          {% endif %}
        </div>

        {%- comment -%} Reg lookup: DVLA call is stubbed pending a server-side proxy + API key -- submitting navigates to native search using the registration until that's connected {%- endcomment -%}
        <div class="vf-panel-{{ ai_gen_id }}" data-vf-panel="reg">
          {% if block.settings.reg_field_label != blank %}
            <span class="vf-panel-label-{{ ai_gen_id }}">{{ block.settings.reg_field_label }}</span>
          {% endif %}
          <form class="vf-cluster-{{ ai_gen_id }}" data-vf-reg-form>
            <div class="vf-reg-input-wrap-{{ ai_gen_id }}">
              <span class="vf-reg-badge-{{ ai_gen_id }}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="10" fill="#FFD700"/>
                </svg>
                UK
              </span>
              <input
                type="text"
                class="vf-reg-input-{{ ai_gen_id }}"
                data-vf-reg-input
                maxlength="8"
                autocomplete="off"
                autocapitalize="characters"
                placeholder="{{ block.settings.reg_placeholder }}"
              >
            </div>
            <button type="submit" class="vf-btn-{{ ai_gen_id }}">{{ block.settings.reg_button_label }}</button>
          </form>
          {% if block.settings.reg_note != blank %}
            <p class="vf-note-{{ ai_gen_id }}">{{ block.settings.reg_note }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</vehicle-finder-{{ ai_gen_id }}>

<script>
  (function () {
    class VehicleFinder{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.tabs = this.querySelectorAll('[data-vf-tab]');
        this.panels = this.querySelectorAll('[data-vf-panel]');
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => this.switchTab(tab.dataset.vfTab));
        });

        this.regForm = this.querySelector('[data-vf-reg-form]');
        if (this.regForm) {
          this.regForm.addEventListener('submit', (event) => this.handleRegSubmit(event));
        }

        this.regInput = this.querySelector('[data-vf-reg-input]');
        if (this.regInput) {
          this.regInput.addEventListener('input', () => {
            this.regInput.value = this.regInput.value.toUpperCase();
          });
        }
      }

      switchTab(name) {
        this.tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.vfTab === name));
        this.panels.forEach((panel) => panel.classList.toggle('is-active', panel.dataset.vfPanel === name));
      }

      handleRegSubmit(event) {
        event.preventDefault();
        const reg = this.regInput.value.replace(/\s+/g, '').trim();
        if (!reg) {
          this.regInput.focus();
          return;
        }

        // DVLA's Vehicle Enquiry Service requires a server-side API key (it cannot be
        // called from the browser: no CORS support, and exposing the key in theme JS
        // would leak it). Once a backend proxy + API key exist, replace this block with
        // a fetch() to that proxy endpoint, e.g.:
        //   fetch('/apps/dvla-lookup?registration=' + encodeURIComponent(reg))
        //     .then((r) => r.json())
        //     .then((vehicle) => { ...redirect to /search using vehicle.make/model/year... });
        // Until then, send the registration itself into native Shopify search so this
        // tab stays functional rather than a dead end.
        const params = new URLSearchParams();
        params.set('type', 'product');
        params.set('q', reg);
        window.location.href = {{ routes.search_url | json }} + '?' + params.toString();
      }
    }

    if (!customElements.get('vehicle-finder-{{ ai_gen_id }}')) {
      customElements.define('vehicle-finder-{{ ai_gen_id }}', VehicleFinder{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Vehicle parts finder",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Parts For Your Vehicle"
    },
    {
      "type": "text",
      "id": "search_tab_label",
      "label": "Search tab label",
      "default": "Search by Parts"
    },
    {
      "type": "text",
      "id": "reg_tab_label",
      "label": "Reg lookup tab label",
      "default": "Reg Lookup"
    },
    {
      "type": "header",
      "content": "Search by Parts"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Label above search bar",
      "info": "Optional small label shown above the input, e.g. \"What are you looking for?\". Leave blank to hide."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search input placeholder",
      "default": "Search for parts..."
    },
    {
      "type": "color",
      "id": "search_input_bg_color",
      "label": "Search field background",
      "default": "#fbe4e4"
    },
    {
      "type": "text",
      "id": "find_button_label",
      "label": "Search button label",
      "default": "Find Parts"
    },
    {
      "type": "text",
      "id": "search_note",
      "label": "Helper note below search (optional)"
    },
    {
      "type": "header",
      "content": "Reg lookup"
    },
    {
      "type": "text",
      "id": "reg_field_label",
      "label": "Label above reg input",
      "default": "Enter UK Registration:"
    },
    {
      "type": "text",
      "id": "reg_placeholder",
      "label": "Reg input placeholder",
      "default": "YY26 ABC"
    },
    {
      "type": "text",
      "id": "reg_button_label",
      "label": "Reg lookup button label",
      "default": "Find Parts"
    },
    {
      "type": "text",
      "id": "reg_note",
      "label": "Reg lookup helper note",
      "default": "We're setting up full registration lookup. For now, this searches your registration number across our catalog.",
      "info": "DVLA's API needs a server-side key + proxy, which isn't connected yet -- see the code comment in this block. Submitting currently searches the reg number directly."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 14
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "body_text_color",
      "label": "Inactive tab text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "note_text_color",
      "label": "Label & note text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "dropdown_bg_color",
      "label": "Inactive tab background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (buttons, active tab)",
      "default": "#a50000"
    },
    {
      "type": "color",
      "id": "accent_hover_color",
      "label": "Accent hover color",
      "default": "#7a0000"
    }
  ],
  "presets": [
    {
      "name": "Vehicle parts finder"
    }
  ]
}
{% endschema %}
