{% doc %}
  @prompt
    Generate a reusable "image + text + checklist" feature section for the About Us page (used twice: "How We Work" and "Our Services"), matching a reference screenshot: small red uppercase eyebrow label, bold heading, a short paragraph, a checklist of items with a red check icon, and an image on the opposite side. The image side (left/right) must be switchable from the theme editor per-instance. On mobile the image always shows above the text. Every font family, size, color and the image must be editable from the theme editor for both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_feature_image_class = 'ai-feature__image-' | append: ai_gen_id %}

{% style %}
  .ai-feature-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-feature__container-{{ai_gen_id}} {
    {% if block.settings.edge_bleed_image %}
      width: 100%;
      max-width: none;
      margin: 0;
      {% if block.settings.image_position == 'left' %}
        padding-left: max(0px, calc((100% - min({{ block.settings.container_width_percent }}%, {{ block.settings.content_max_width }}px)) / 2));
        padding-right: 0;
      {% else %}
        padding-right: max(0px, calc((100% - min({{ block.settings.container_width_percent }}%, {{ block.settings.content_max_width }}px)) / 2));
        padding-left: 0;
      {% endif %}
    {% else %}
      width: {{ block.settings.container_width_percent }}%;
      max-width: {{ block.settings.content_max_width }}px;
      margin: 0 auto;
    {% endif %}
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.column_gap }}px;
    {% if block.settings.image_position == 'left' %}
      flex-direction: row;
    {% else %}
      flex-direction: row-reverse;
    {% endif %}
  }

  .ai-feature__text-{{ai_gen_id}},
  .ai-feature__image-col-{{ai_gen_id}} {
    flex: 1 1 0;
    min-width: 0;
  }

  .ai-feature__eyebrow-{{ai_gen_id}} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-style: {{ block.settings.eyebrow_font.style }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    text-transform: {{ block.settings.eyebrow_case }};
    margin: 0 0 {{ block.settings.eyebrow_spacing_bottom }}px 0;
    display: block;
  }

  .ai-feature__heading-{{ai_gen_id}} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing_bottom }}px 0;
  }

  .ai-feature__description-{{ai_gen_id}} {
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-style: {{ block.settings.description_font.style }};
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.list_item_spacing | times: 1.5 }}px 0;
  }

  .ai-feature__description-{{ai_gen_id}} p {
    margin: 0 0 10px 0;
  }

  .ai-feature__list-{{ai_gen_id}} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.list_item_spacing }}px;
  }

  .ai-feature__list-item-{{ai_gen_id}} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-feature__list-icon-{{ai_gen_id}} {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    color: {{ block.settings.list_icon_color }};
  }

  .ai-feature__list-icon-{{ai_gen_id}} svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .ai-feature__list-text-{{ai_gen_id}} {
    font-family: {{ block.settings.list_text_font.family }}, {{ block.settings.list_text_font.fallback_families }};
    font-weight: {{ block.settings.list_text_font.weight }};
    font-style: {{ block.settings.list_text_font.style }};
    font-size: {{ block.settings.list_text_size }}px;
    color: {{ block.settings.list_text_color }};
    line-height: 1.3;
  }

  .ai-feature__image-{{ai_gen_id}} {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_radius }}px;
    object-fit: {{ block.settings.image_fit }};
    {% unless block.settings.image_aspect_ratio == 'auto' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endunless %}
  }

  .ai-feature__image-placeholder-{{ai_gen_id}} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    background: #f1f1f1;
  }

  .ai-feature__image-placeholder-{{ai_gen_id}} svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 989px) {
    .ai-feature__heading-{{ai_gen_id}} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-{{ai_gen_id}} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-feature__container-{{ai_gen_id}} {
      flex-direction: column;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-feature__image-col-{{ai_gen_id}} {
      order: -1;
      width: 100%;
    }

    .ai-feature__text-{{ai_gen_id}} {
      order: 2;
      width: 100%;
      {% if block.settings.edge_bleed_image %}
        {% if block.settings.image_position == 'left' %}
          padding-right: max(0px, calc((100% - min({{ block.settings.container_width_percent }}%, {{ block.settings.content_max_width }}px)) / 2));
        {% else %}
          padding-left: max(0px, calc((100% - min({{ block.settings.container_width_percent }}%, {{ block.settings.content_max_width }}px)) / 2));
        {% endif %}
      {% endif %}
    }

    .ai-feature__eyebrow-{{ai_gen_id}} {
      font-size: {{ block.settings.eyebrow_size_mobile }}px;
    }

    .ai-feature__heading-{{ai_gen_id}} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-feature__description-{{ai_gen_id}} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }

    .ai-feature__list-text-{{ai_gen_id}} {
      font-size: {{ block.settings.list_text_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-feature-{{ai_gen_id}}">
  <div class="ai-feature__container-{{ai_gen_id}}">
    <div class="ai-feature__text-{{ai_gen_id}}">
      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-feature__eyebrow-{{ai_gen_id}}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
      {% if block.settings.heading_text != blank %}
        <h2 class="ai-feature__heading-{{ai_gen_id}}">{{ block.settings.heading_text }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-feature__description-{{ai_gen_id}}">{{ block.settings.description }}</div>
      {% endif %}
      <ul class="ai-feature__list-{{ai_gen_id}}">
        {% for i in (1..6) %}
          {% assign enabled_key = 'item_' | append: i | append: '_enabled' %}
          {% assign text_key = 'item_' | append: i | append: '_text' %}
          {% if block.settings[enabled_key] and block.settings[text_key] != blank %}
            <li class="ai-feature__list-item-{{ai_gen_id}}">
              <span class="ai-feature__list-icon-{{ai_gen_id}}">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M7.5 12.5L10.3 15.3L16.5 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="ai-feature__list-text-{{ai_gen_id}}">{{ block.settings[text_key] }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class="ai-feature__image-col-{{ai_gen_id}}">
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: class: ai_feature_image_class, alt: block.settings.image_alt, loading: 'lazy', widths: '400,600,800,1000,1200,1600' }}
      {% else %}
        <div class="ai-feature__image-placeholder-{{ai_gen_id}}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature + checklist",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "edge_bleed_image",
      "label": "Remove padding on the image's outer edge",
      "info": "Lets the image touch the edge of the page (desktop and mobile) instead of keeping the container's side gap. The other side (text) keeps its normal padding.",
      "default": false
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_width_percent",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Container width",
      "default": 90
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between columns (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns (mobile)",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "How We Work"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#a50000"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "min": 8,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 12
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Letter spacing",
      "default": 2
    },
    {
      "type": "select",
      "id": "eyebrow_case",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "eyebrow_spacing_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Spacing below",
      "default": 12
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "Infuse Your Brand With Excellence"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "assistant_n7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 34
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1,
      "max": 1.6,
      "step": 0.1,
      "label": "Line height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "heading_spacing_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Spacing below",
      "default": 16
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas turpis dui, sollicitudin pellentesque tempus id, sed lectus.</p>"
    },
    {
      "type": "font_picker",
      "id": "description_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#5c5c5c"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Line height",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Checklist"
    },
    {
      "type": "color",
      "id": "list_icon_color",
      "label": "Icon color",
      "default": "#a50000"
    },
    {
      "type": "font_picker",
      "id": "list_text_font",
      "label": "Font",
      "default": "assistant_n6"
    },
    {
      "type": "color",
      "id": "list_text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "list_text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 15
    },
    {
      "type": "range",
      "id": "list_text_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "list_item_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between items",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "item_1_enabled",
      "label": "Enable item 1",
      "default": true
    },
    {
      "type": "text",
      "id": "item_1_text",
