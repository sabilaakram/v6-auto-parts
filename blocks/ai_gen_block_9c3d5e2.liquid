    },
    {
      "type": "text",
      "id": "item_4_text",
      "label": "Item 4 text"
    },
    {
      "type": "checkbox",
      "id": "item_5_enabled",
      "label": "Enable item 5",
      "default": false
    },
    {
      "type": "text",
      "id": "item_5_text",
      "label": "Item 5 text"
    },
    {
      "type": "checkbox",
      "id": "item_6_enabled",
      "label": "Enable item 6",
      "default": false
    },
    {
      "type": "text",
      "id": "item_6_text",
