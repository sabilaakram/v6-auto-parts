{% doc %}
  @prompt
    Create a responsive “Why Choose Us / Professional Support” feature section with a dark background and decorative angled/notched white shapes at the top and bottom, similar to an automotive/e-commerce style.
    
    Add a small upper heading, a large centered main heading, and below it a dynamic feature grid.
    
    Each feature should be added as a Shopify block, so I can increase, decrease, remove, and reorder the number of items from the Theme Editor.
    
    Each feature block must include:
    
    Upload/select SVG icon
    Feature title
    Short description
    Icon background color
    Icon size
    Icon circle size
    Title and description styling
    
    Make the grid responsive and automatically adjust depending on the number of blocks:
    
    Desktop: configurable 2, 3, or 4 columns
    Tablet: 2 columns
    Mobile: 1 or 2 columns selectable from Theme Editor
    
    Allow me to control from the Shopify Theme Editor:
    
    Section background color
    Small heading text, color, font family, size, weight, letter spacing
    Main heading text, font family, size, weight, line height, color
    Heading alignment and spacing
    Grid gap
    Section height/padding
    Number of desktop/mobile columns
    Feature title and description typography
    Icon colors, sizes, and spacing
    
    SVG icons must be uploaded individually for each block from the Theme Editor, not hard-coded.
    
    Keep all styling scoped only to this section, make it fully responsive, and ensure adding more feature blocks does not break the layout., for the main container dont add the tilted lines, use a simple straight lines
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-why-choose-us-{{ ai_gen_id }} {
    display: block;
    position: relative;
    background-color: {{ block.settings.section_bg_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px 0;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-why-choose-us-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: {{ block.settings.border_thickness }}px;
    background-color: {{ block.settings.border_color }};
    z-index: 1;
  }

  .ai-why-choose-us-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: {{ block.settings.border_thickness }}px;
    background-color: {{ block.settings.border_color }};
    z-index: 1;
  }

  .ai-why-choose-us-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 2;
  }

  .ai-why-choose-us-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_bottom_spacing }}px;
  }

  .ai-why-choose-us-small-heading-{{ ai_gen_id }} {
    color: {{ block.settings.small_heading_color }};
    font-family: {{ block.settings.small_heading_font.family }}, {{ block.settings.small_heading_font.fallback_families }};
    font-weight: {{ block.settings.small_heading_font.weight }};
    font-size: {{ block.settings.small_heading_size }}px;
    letter-spacing: {{ block.settings.small_heading_letter_spacing }}px;
    text-transform: uppercase;
    margin: 0 0 {{ block.settings.small_heading_bottom_margin }}px 0;
  }

  .ai-why-choose-us-main-heading-{{ ai_gen_id }} {
    color: {{ block.settings.main_heading_color }};
    font-family: {{ block.settings.main_heading_font.family }}, {{ block.settings.main_heading_font.fallback_families }};
    font-weight: {{ block.settings.main_heading_font.weight }};
    font-size: {{ block.settings.main_heading_size }}px;
    line-height: {{ block.settings.main_heading_line_height }};
    margin: 0;
  }

  .ai-why-choose-us-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0 auto;
  }

  .ai-why-choose-us-feature-{{ ai_gen_id }} {
    text-align: center;
    padding: {{ block.settings.feature_padding }}px;
  }

  .ai-why-choose-us-icon-wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_bottom_spacing }}px;
  }

  .ai-why-choose-us-icon-circle-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_circle_size }}px;
    height: {{ block.settings.icon_circle_size }}px;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: 50%;
    transition: transform 0.3s ease;
  }

  .ai-why-choose-us-feature-{{ ai_gen_id }}:hover .ai-why-choose-us-icon-circle-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-why-choose-us-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-why-choose-us-feature-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_bottom_spacing }}px 0;
  }

  .ai-why-choose-us-feature-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-family: {{ block.settings.description_font.family }}, {{ block.settings.description_font.fallback_families }};
    font-weight: {{ block.settings.description_font.weight }};
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-why-choose-us-main-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.8);
    }

    .ai-why-choose-us-small-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.small_heading_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-why-choose-us-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-why-choose-us-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px 0;
      width: 100%;
    }

    .ai-why-choose-us-main-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.main_heading_size }}px * 0.6);
    }

    .ai-why-choose-us-small-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.small_heading_size }}px * 0.8);
    }

    .ai-why-choose-us-feature-{{ ai_gen_id }} {
      padding: {{ block.settings.feature_padding | times: 0.7 }}px;
    }

    .ai-why-choose-us-icon-circle-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_circle_size }}px * 0.8);
      height: calc({{ block.settings.icon_circle_size }}px * 0.8);
    }

    .ai-why-choose-us-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }
  }
{% endstyle %}

<why-choose-us-{{ ai_gen_id }} class="ai-why-choose-us-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-why-choose-us-container-{{ ai_gen_id }}">
    <div class="ai-why-choose-us-header-{{ ai_gen_id }}">
      {% if block.settings.small_heading != blank %}
        <div class="ai-why-choose-us-small-heading-{{ ai_gen_id }}">
          {{ block.settings.small_heading }}
        </div>
      {% endif %}

      {% if block.settings.main_heading != blank %}
        <h2 class="ai-why-choose-us-main-heading-{{ ai_gen_id }}">
          {{ block.settings.main_heading }}
        </h2>
      {% endif %}
    </div>

    <div class="ai-why-choose-us-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
          assign feature_icon_key = 'feature_' | append: i | append: '_icon'
          assign feature_title_key = 'feature_' | append: i | append: '_title'
          assign feature_desc_key = 'feature_' | append: i | append: '_description'

          assign feature_enabled = block.settings[feature_enabled_key]
          assign feature_icon = block.settings[feature_icon_key]
          assign feature_title = block.settings[feature_title_key]
          assign feature_desc = block.settings[feature_desc_key]
        %}

        {% if feature_enabled %}
          <div class="ai-why-choose-us-feature-{{ ai_gen_id }}" data-feature-id="{{ i }}">
            <div class="ai-why-choose-us-icon-wrapper-{{ ai_gen_id }}">
              <div class="ai-why-choose-us-icon-circle-{{ ai_gen_id }}">
                <div class="ai-why-choose-us-icon-{{ ai_gen_id }}">
                  {% if feature_icon != blank %}
                    {{ feature_icon }}
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="{{ block.settings.title_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  {% endif %}
                </div>
              </div>
            </div>

            {% if feature_title != blank %}
              <h3 class="ai-why-choose-us-feature-title-{{ ai_gen_id }}">
                {{ feature_title }}
              </h3>
            {% endif %}

            {% if feature_desc != blank %}
              <div class="ai-why-choose-us-feature-description-{{ ai_gen_id }}">
                {{ feature_desc }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</why-choose-us-{{ ai_gen_id }}>

<script>
  (function() {
    class WhyChooseUs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeFeatures();
      }

      initializeFeatures() {
        const features = this.querySelectorAll('.ai-why-choose-us-feature-{{ ai_gen_id }}');
        
        features.forEach((feature, index) => {
          feature.style.opacity = '0';
          feature.style.transform = 'translateY(20px)';
          feature.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
          
          setTimeout(() => {
            feature.style.opacity = '1';
            feature.style.transform = 'translateY(0)';
          }, index * 100);
        });
      }
    }

    customElements.define('why-choose-us-{{ ai_gen_id }}', WhyChooseUs{{ ai_gen_id }});
  })();
</script>

