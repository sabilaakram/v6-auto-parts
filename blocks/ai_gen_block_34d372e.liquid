{% doc %}
  @prompt
    generate a section with the main heading in the top at the center, who's style will be customized and then add the carousel below it, and on the desktop mobile and tablet screens (on all screens) their will be 3 products 1 in the center the 2 at the left and right, with the offset of left and right, and i will set the offset as i want, on every product their will be image as the background and the text on it, the text will be customized, and the text/ image will link to the specific collection or product or page,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_bottom_margin }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: {{ block.settings.heading_line_height }};
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding: 20px 0;
  }

  .ai-carousel-track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    height: {{ block.settings.carousel_height }}px;
  }

  .ai-carousel-item-{{ ai_gen_id }} {
    position: absolute;
    transition: all 0.5s ease;
    border-radius: {{ block.settings.item_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
  }

  .ai-carousel-item-{{ ai_gen_id }}.center {
    width: {{ block.settings.center_width }}%;
    height: 100%;
    z-index: 3;
    left: 50%;
    transform: translateX(-50%) scale(1);
    opacity: 1;
  }

  .ai-carousel-item-{{ ai_gen_id }}.left {
    width: {{ block.settings.side_width }}%;
    height: {{ block.settings.side_height }}%;
    z-index: 2;
    left: {{ block.settings.left_offset }}%;
    transform: scale(0.9);
    opacity: {{ block.settings.side_opacity }};
  }

  .ai-carousel-item-{{ ai_gen_id }}.right {
    width: {{ block.settings.side_width }}%;
    height: {{ block.settings.side_height }}%;
    z-index: 2;
    right: {{ block.settings.right_offset }}%;
    transform: scale(0.9);
    opacity: {{ block.settings.side_opacity }};
  }

  .ai-carousel-item-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
    z-index: 1;
  }

  .ai-carousel-item-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }

  .ai-carousel-item-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-carousel-item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-item-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-carousel-item-text-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    line-height: {{ block.settings.text_line_height }};
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    background-color: {{ block.settings.text_background_color }};
    padding: {{ block.settings.text_padding }}px;
    border-radius: {{ block.settings.text_border_radius }}px;
  }

  .ai-carousel-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-carousel-nav-button-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.nav_inactive_color }};
    cursor: pointer;
    transition: background-color 0.3s ease;
    padding: 0;
  }

  .ai-carousel-nav-button-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.nav_active_color }};
  }

  .ai-carousel-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      line-height: {{ block.settings.heading_line_height_mobile }};
    }

    .ai-carousel-item-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
      line-height: {{ block.settings.text_line_height_mobile }};
    }

    {% if block.settings.mobile_single_view %}
      .ai-carousel-item-{{ ai_gen_id }}.left,
      .ai-carousel-item-{{ ai_gen_id }}.right {
        opacity: 0;
        pointer-events: none;
      }

      .ai-carousel-item-{{ ai_gen_id }}.center {
        width: 100%;
      }
    {% else %}
      .ai-carousel-item-{{ ai_gen_id }}.left {
        left: {{ block.settings.left_offset_mobile }}%;
      }

      .ai-carousel-item-{{ ai_gen_id }}.right {
        right: {{ block.settings.right_offset_mobile }}%;
      }
    {% endif %}
  }
{% endstyle %}

<carousel-component-{{ ai_gen_id }} class="ai-carousel-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-carousel-track-{{ ai_gen_id }}" data-carousel-track>
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'item_' | append: i | append: '_image'
            assign text_key = 'item_' | append: i | append: '_text'
            assign link_key = 'item_' | append: i | append: '_link'
            assign link_type_key = 'item_' | append: i | append: '_link_type'

            assign item_image = block.settings[image_key]
            assign item_text = block.settings[text_key]
            assign item_link = block.settings[link_key]
            assign item_link_type = block.settings[link_type_key]

            assign final_link = ''
            case item_link_type
              when 'product'
                if item_link != blank
                  assign final_link = item_link.url
                endif
              when 'collection'
                if item_link != blank
                  assign final_link = item_link.url
                endif
              when 'page'
                if item_link != blank
                  assign final_link = item_link.url
                endif
            endcase
          %}

          <div class="ai-carousel-item-{{ ai_gen_id }}" data-carousel-item>
            {% if final_link != blank %}
              <a href="{{ final_link }}" class="ai-carousel-item-link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-carousel-item-link-{{ ai_gen_id }}">
            {% endif %}
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 1000 }}"
                  alt="{{ item_image.alt | escape }}"
                  class="ai-carousel-item-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ item_image.width }}"
                  height="{{ item_image.height }}"
                >
              {% else %}
                <div class="ai-carousel-item-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if item_text != blank %}
                <div class="ai-carousel-item-text-{{ ai_gen_id }}">
                  {{ item_text }}
                </div>
              {% endif %}
            {% if final_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-carousel-nav-{{ ai_gen_id }}" data-carousel-nav></div>
  </div>
</carousel-component-{{ ai_gen_id }}>

<script>
  (function() {
    class CarouselComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.items = [];
        this.navButtons = [];
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.navContainer = this.querySelector('[data-carousel-nav]');
        this.items = Array.from(this.querySelectorAll('[data-carousel-item]'));

        if (this.items.length === 0) return;

        this.createNavButtons();
        this.updateCarousel();

        if ({{ block.settings.autoplay }}) {
          this.startAutoplay();
        }

        this.items.forEach((item, index) => {
          item.addEventListener('click', (e) => {
            if (!item.classList.contains('center')) {
              e.preventDefault();
              this.goToSlide(index);
            }
          });
        });
      }

      createNavButtons() {
        this.items.forEach((_, index) => {
          const button = document.createElement('button');
          button.classList.add('ai-carousel-nav-button-{{ ai_gen_id }}');
          button.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          button.addEventListener('click', () => this.goToSlide(index));
          this.navButtons.push(button);
          this.navContainer.appendChild(button);
        });
      }

      updateCarousel() {
        this.items.forEach((item, index) => {
          item.classList.remove('center', 'left', 'right', 'hidden');

          if (index === this.currentIndex) {
            item.classList.add('center');
          } else if (index === this.getPrevIndex()) {
            item.classList.add('left');
          } else if (index === this.getNextIndex()) {
            item.classList.add('right');
          } else {
            item.classList.add('hidden');
          }
        });

        this.navButtons.forEach((button, index) => {
          if (index === this.currentIndex) {
            button.classList.add('active');
          } else {
            button.classList.remove('active');
          }
        });
      }

      getPrevIndex() {
        return (this.currentIndex - 1 + this.items.length) % this.items.length;
      }

      getNextIndex() {
        return (this.currentIndex + 1) % this.items.length;
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
        if ({{ block.settings.autoplay }}) {
          this.resetAutoplay();
        }
      }

      next() {
        this.currentIndex = this.getNextIndex();
        this.updateCarousel();
      }

      startAutoplay() {
        this.autoplayInterval = setInterval(() => {
          this.next();
        }, {{ block.settings.autoplay_speed }} * 1000);
      }

      resetAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
        }
      }
    }

    customElements.define('carousel-component-{{ ai_gen_id }}', CarouselComponent{{ ai_gen_id }});
  })();
</script>

