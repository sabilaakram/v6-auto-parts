{% doc %}
  @prompt
    Generate a simple hero section for a Contact Us page: a large bold heading on one side ("Contact Us") and a large image on the other side (e.g. a car), white background, no button. Image side must be switchable from the theme editor, and on mobile the image and heading stack with an editable order. All fonts (family, size, style/weight, color) and the image must be editable from the theme editor for desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_hero_image_class = 'ai-contact-hero__image-' | append: ai_gen_id %}

{% style %}
  .ai-contact-hero-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .ai-contact-hero__container-{{ai_gen_id}} {
    width: {{ block.settings.container_width_percent }}%;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    gap: {{ block.settings.column_gap }}px;
    {% if block.settings.image_position == 'left' %}
      flex-direction: row;
    {% else %}
      flex-direction: row-reverse;
    {% endif %}
  }

  .ai-contact-hero__text-{{ai_gen_id}},
  .ai-contact-hero__image-col-{{ai_gen_id}} {
    flex: 1 1 0;
    min-width: 0;
  }

  .ai-contact-hero__eyebrow-{{ai_gen_id}} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-style: {{ block.settings.eyebrow_font.style }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    text-transform: {{ block.settings.eyebrow_case }};
    margin: 0 0 {{ block.settings.eyebrow_spacing_bottom }}px 0;
    display: block;
  }

  .ai-contact-hero__heading-{{ai_gen_id}} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_case }};
    margin: 0 0 {{ block.settings.heading_spacing_bottom }}px 0;
  }

  .ai-contact-hero__subheading-{{ai_gen_id}} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: {{ block.settings.subheading_line_height }};
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-contact-hero__image-{{ai_gen_id}} {
    display: block;
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_radius }}px;
    object-fit: {{ block.settings.image_fit }};
    {% unless block.settings.image_aspect_ratio == 'auto' %}
      aspect-ratio: {{ block.settings.image_aspect_ratio }};
    {% endunless %}
  }

  .ai-contact-hero__image-placeholder-{{ai_gen_id}} {
    width: 100%;
    border-radius: {{ block.settings.image_radius }}px;
    background: #f1f1f1;
  }

  @media screen and (max-width: 989px) {
    .ai-contact-hero__heading-{{ai_gen_id}} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-contact-hero-{{ai_gen_id}} {
      padding: {{ block.settings.section_padding_top_mobile }}px 0 {{ block.settings.section_padding_bottom_mobile }}px;
    }

    .ai-contact-hero__container-{{ai_gen_id}} {
      flex-direction: column;
      gap: {{ block.settings.column_gap_mobile }}px;
    }

    .ai-contact-hero__image-col-{{ai_gen_id}} {
      width: 100%;
      {% if block.settings.mobile_image_position == 'above' %}
        order: -1;
      {% else %}
        order: 2;
      {% endif %}
    }

    .ai-contact-hero__text-{{ai_gen_id}} {
      width: 100%;
      order: 1;
    }

    .ai-contact-hero__eyebrow-{{ai_gen_id}} {
      font-size: {{ block.settings.eyebrow_size_mobile }}px;
    }

    .ai-contact-hero__heading-{{ai_gen_id}} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-contact-hero__subheading-{{ai_gen_id}} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-contact-hero-{{ai_gen_id}}">
  <div class="ai-contact-hero__container-{{ai_gen_id}}">
    <div class="ai-contact-hero__text-{{ai_gen_id}}">
      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-contact-hero__eyebrow-{{ai_gen_id}}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
      {% if block.settings.heading_text != blank %}
        <h1 class="ai-contact-hero__heading-{{ai_gen_id}}">{{ block.settings.heading_text }}</h1>
      {% endif %}
      {% if block.settings.subheading_text != blank %}
        <p class="ai-contact-hero__subheading-{{ai_gen_id}}">{{ block.settings.subheading_text }}</p>
      {% endif %}
    </div>
    <div class="ai-contact-hero__image-col-{{ai_gen_id}}">
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 1600 | image_tag: class: ai_hero_image_class, alt: block.settings.image_alt, loading: 'lazy', widths: '400,600,800,1000,1200,1600' }}
      {% else %}
        <div class="ai-contact-hero__image-placeholder-{{ai_gen_id}}">
          {{ 'hero-apparel-2' | placeholder_svg_tag: ai_hero_image_class }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Image position (mobile)",
      "options": [
        { "value": "above", "label": "Above text" },
        { "value": "below", "label": "Below text" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "container_width_percent",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Container width",
      "default": 90
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "label": "Max width",
      "default": 1500
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Gap between columns (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap between columns (mobile)",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding top (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (desktop)",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 0
    },
    {
      "type": "header",
      "content": "Eyebrow (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text"
    },
    {
      "type": "font_picker",
      "id": "eyebrow_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#a50000"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 8,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Size (desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "eyebrow_size_mobile",
      "min": 8,
      "max": 22,
