{% doc %}
  @prompt
    generate a section with the main heading in the top at the center which is responsive, who's style will be customized, including the font family, case and then add the carousel below it (the number of items will be based on the number of the images i will add, whether 3 or more), and on the desktop mobile and tablet screens (on all screens) their will be 3 products 1 in the center the 2 at the left and right (sizes on different screen sizes will be different), with the offset of left and right, and i will set the offset as i want, on every product their will be image as the background and the text on it (the placement of the text whether center left right top bottom or any where will be customized from the frontend), the text will be customized (including font family, size, color, weigth, case), and the text/ image will link to the specific collection or product or page,
    give me an option to hide the pagination from the screen, the space between the items will also be customized
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-carousel-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-carousel-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: 700;
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.heading_line_height }};
    color: {{ block.settings.heading_color }};
    text-transform: {{ block.settings.heading_text_transform }};
  }

  .ai-carousel-container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .ai-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-carousel-slide-{{ ai_gen_id }} {
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-carousel-slide-{{ ai_gen_id }} a {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-carousel-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-carousel-text-{{ ai_gen_id }} {
    position: absolute;
    font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
    font-weight: {{ block.settings.text_font.weight }};
    font-size: {{ block.settings.text_size }}px;
    line-height: {{ block.settings.text_line_height }};
    color: {{ block.settings.text_color }};
    text-transform: {{ block.settings.text_transform }};
    padding: 10px;
    z-index: 1;
  }

  .ai-carousel-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  {% if block.settings.hide_pagination %}
    .ai-carousel-pagination-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  .ai-carousel-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.pagination_color }};
    opacity: 0.5;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-carousel-dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3);
      height: {{ block.settings.item_height_tablet }}px;
    }

    .ai-carousel-slide-{{ ai_gen_id }}:nth-child(3n + 2) {
      width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3 + {{ block.settings.center_offset_tablet }}px);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-carousel-slide-{{ ai_gen_id }} {
      width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3);
      height: {{ block.settings.item_height_desktop }}px;
    }

    .ai-carousel-slide-{{ ai_gen_id }}:nth-child(3n + 2) {
      width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3 + {{ block.settings.center_offset_desktop }}px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-carousel-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      line-height: {{ block.settings.heading_line_height_mobile }};
    }

    .ai-carousel-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size_mobile }}px;
      line-height: {{ block.settings.text_line_height_mobile }};
    }

    {% if block.settings.mobile_single_view %}
      .ai-carousel-section-{{ ai_gen_id }} {
        width: 100%;
        padding-left: 0;
        padding-right: 0;
      }

      .ai-carousel-wrapper-{{ ai_gen_id }} {
        gap: 0;
      }

      .ai-carousel-slide-{{ ai_gen_id }},
      .ai-carousel-slide-{{ ai_gen_id }}:nth-child(3n + 2) {
        width: 100%;
        height: {{ block.settings.item_height_mobile }}px;
      }
    {% else %}
      .ai-carousel-section-{{ ai_gen_id }} {
        padding-left: 10px;
        padding-right: 10px;
      }

      .ai-carousel-slide-{{ ai_gen_id }} {
        width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3);
        height: {{ block.settings.item_height_mobile }}px;
      }

      .ai-carousel-slide-{{ ai_gen_id }}:nth-child(3n + 2) {
        width: calc((100% - {{ block.settings.item_spacing }}px * 2) / 3 + {{ block.settings.center_offset_mobile }}px);
      }
    {% endif %}
  }
{% endstyle %}

<carousel-component-{{ ai_gen_id }} class="ai-carousel-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-carousel-container-{{ ai_gen_id }}">
    <div class="ai-carousel-wrapper-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign image_key = 'slide_image_' | append: i
          assign text_key = 'slide_text_' | append: i
          assign link_key = 'slide_link_' | append: i
          assign text_position_key = 'slide_text_position_' | append: i

          assign slide_image = block.settings[image_key]
          assign slide_text = block.settings[text_key]
          assign slide_link = block.settings[link_key]
          assign text_position = block.settings[text_position_key]

          if slide_image != blank or slide_text != blank
            assign has_content = true
          else
            assign has_content = false
          endif
        %}

        {% if has_content %}
          <div class="ai-carousel-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if slide_link != blank %}
              <a href="{{ slide_link }}">
            {% else %}
              <a href="#">
            {% endif %}
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 1200 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-carousel-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-carousel-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if slide_text != blank %}
                {% liquid
                  assign top_pos = ''
                  assign bottom_pos = ''
                  assign left_pos = ''
                  assign right_pos = ''
                  assign transform = ''

                  case text_position
                    when 'top-left'
                      assign top_pos = '10px'
                      assign left_pos = '10px'
                    when 'top-center'
                      assign top_pos = '10px'
                      assign left_pos = '50%'
                      assign transform = 'translateX(-50%)'
                    when 'top-right'
                      assign top_pos = '10px'
                      assign right_pos = '10px'
                    when 'center-left'
                      assign top_pos = '50%'
                      assign left_pos = '10px'
                      assign transform = 'translateY(-50%)'
                    when 'center'
                      assign top_pos = '50%'
                      assign left_pos = '50%'
                      assign transform = 'translate(-50%, -50%)'
                    when 'center-right'
                      assign top_pos = '50%'
                      assign right_pos = '10px'
                      assign transform = 'translateY(-50%)'
                    when 'bottom-left'
                      assign bottom_pos = '10px'
                      assign left_pos = '10px'
                    when 'bottom-center'
                      assign bottom_pos = '10px'
                      assign left_pos = '50%'
                      assign transform = 'translateX(-50%)'
                    when 'bottom-right'
                      assign bottom_pos = '10px'
                      assign right_pos = '10px'
                  endcase
                %}
                <div
                  class="ai-carousel-text-{{ ai_gen_id }}"
                  style="
                    {% if top_pos != blank %}top: {{ top_pos }};{% endif %}
                    {% if bottom_pos != blank %}bottom: {{ bottom_pos }};{% endif %}
                    {% if left_pos != blank %}left: {{ left_pos }};{% endif %}
                    {% if right_pos != blank %}right: {{ right_pos }};{% endif %}
                    {% if transform != blank %}transform: {{ transform }};{% endif %}
                  "
                >
                  {{ slide_text }}
                </div>
              {% endif %}
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-carousel-pagination-{{ ai_gen_id }}"></div>
</carousel-component-{{ ai_gen_id }}>

<script>
  (function() {
    class CarouselComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
        this.mobileSingleView = {{ block.settings.mobile_single_view }};
        this.handleResize = this.handleResize.bind(this);
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-carousel-wrapper-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}');
        this.pagination = this.querySelector('.ai-carousel-pagination-{{ ai_gen_id }}');
        this.slideCount = this.slides.length;

        if (this.slideCount === 0) return;

        this.buildPagination();
        this.updateCarousel();
        this.startAutoplay();

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
        window.addEventListener('resize', this.handleResize);
      }

      getItemsPerPage() {
        const isMobile = window.matchMedia('(max-width: 749px)').matches;
        if (isMobile && this.mobileSingleView) return 1;
        return 3;
      }

      buildPagination() {
        this.pagination.innerHTML = '';
        const itemsPerPage = this.getItemsPerPage();
        const totalPages = Math.ceil(this.slideCount / itemsPerPage);

        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => {
            this.currentIndex = i;
            this.updateCarousel();
          });
          this.pagination.appendChild(dot);
        }
      }

      updateCarousel() {
        const offset = this.currentIndex * -100;
        this.wrapper.style.transform = `translateX(${offset}%)`;

        const dots = this.pagination.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      handleResize() {
        clearTimeout(this.resizeTimeout);
        this.resizeTimeout = setTimeout(() => {
          this.currentIndex = 0;
          this.buildPagination();
          this.updateCarousel();
        }, 150);
      }

      startAutoplay() {
        const itemsPerPage = this.getItemsPerPage();
        const totalPages = Math.ceil(this.slideCount / itemsPerPage);
        this.autoplayInterval = setInterval(() => {
          this.currentIndex = (this.currentIndex + 1) % totalPages;
          this.updateCarousel();
        }, {{ block.settings.autoplay_speed | times: 1000 }});
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
        window.removeEventListener('resize', this.handleResize);
      }
    }

    customElements.define('carousel-component-{{ ai_gen_id }}', CarouselComponent{{ ai_gen_id }});
  })();
</script>

