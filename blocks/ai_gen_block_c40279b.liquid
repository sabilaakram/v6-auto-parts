    <div class="ai-header-bottom-row-{{ ai_gen_id }}">
      <nav class="ai-header-nav-{{ ai_gen_id }}">
        {% if block.settings.menu != blank %}
          <ul class="ai-header-nav-list-{{ ai_gen_id }}">
            {% for link in block.settings.menu.links %}
              <li class="ai-header-nav-item-{{ ai_gen_id }}">
                <a href="{{ link.url }}" class="ai-header-nav-link-{{ ai_gen_id }}">
                  {{ link.title }}
                  {% if link.links.size > 0 %}
                    <svg class="ai-header-nav-arrow-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  {% endif %}
                </a>
                {% if link.links.size > 0 %}
                  <div class="ai-header-nav-dropdown-{{ ai_gen_id }}">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" class="ai-header-nav-dropdown-link-{{ ai_gen_id }}">{{ child_link.title }}</a>
                    {% endfor %}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>
