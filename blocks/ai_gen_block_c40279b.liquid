          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="ai-header-drawer-search-{{ ai_gen_id }}">
      <form action="/search" method="get" class="ai-header-drawer-search-form-{{ ai_gen_id }}" role="search">
        <input
          type="search"
          name="q"
          class="ai-header-drawer-search-input-{{ ai_gen_id }}"
          placeholder="Search for parts..."
          aria-label="Search"
        >
      </form>
    </div>

    {% if block.settings.show_rewards %}
      <div class="ai-header-drawer-rewards-{{ ai_gen_id }}">
        <a href="{{ block.settings.rewards_link }}" class="ai-header-drawer-rewards-link-{{ ai_gen_id }}">Rewards</a>
      </div>
    {% endif %}

    {% if block.settings.show_drawer_account %}
      <div class="ai-header-drawer-account-{{ ai_gen_id }}">
        <a href="/account" class="ai-header-drawer-account-link-{{ ai_gen_id }}">Account</a>
      </div>
    {% endif %}

    <nav class="ai-header-drawer-nav-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        <ul class="ai-header-drawer-nav-list-{{ ai_gen_id }}">
          {% for link in block.settings.menu.links %}
            <li class="ai-header-drawer-nav-item-{{ ai_gen_id }}">
              <a href="{{ link.url }}" class="ai-header-drawer-nav-link-{{ ai_gen_id }}">{{ link.title }}</a>
              {% if link.links.size > 0 %}
                <div class="ai-header-drawer-nav-dropdown-{{ ai_gen_id }}">
                  {% for child_link in link.links %}
                    <a href="{{ child_link.url }}" class="ai-header-drawer-nav-dropdown-link-{{ ai_gen_id }}">{{ child_link.title }}</a>
                  {% endfor %}
