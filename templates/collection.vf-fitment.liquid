{%- comment -%}
  Slim JSON product feed for the vehicle finder's registration lookup
  (blocks/vehicle_finder.liquid). Requested as /collections/all?view=vf-fitment&page=N.
  Only title, url, image, price, availability and tags -- the block's JS matches these
  against the DVLA vehicle (make / year / fuel / engine size) in the browser.
{%- endcomment -%}
{%- layout none -%}
{%- paginate collection.products by 250 -%}
{"page":{{ paginate.current_page | default: 1 }},"pages":{{ paginate.pages | default: 1 }},"products":[
{%- for product in collection.products -%}
{"t":{{ product.title | json }},"u":{{ product.url | json }},"i":{% if product.featured_image %}{{ product.featured_image | image_url: width: 360 | json }}{% else %}null{% endif %},"p":{{ product.price | money | json }},"c":{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money | json }}{% else %}null{% endif %},"a":{{ product.available | json }},"g":{{ product.tags | join: ' | ' | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
{%- endpaginate -%}
