{% layout none %}
{%- comment -%}
  Product data as JSON, loaded by the Compare page via /products/<handle>?view=v6data.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign specs = product.metafields.custom.specs.value
  assign image = ''
  if product.featured_image
    assign image = product.featured_image | image_url: width: 500
  endif
  assign compare_at = ''
  if product.compare_at_price > product.price
    assign compare_at = product.compare_at_price | money
  endif
-%}
{"id":{{ product.id | json }},"handle":{{ product.handle | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ image | json }},"price":{{ product.price | money | json }},"compare_at":{{ compare_at | json }},"available":{{ product.available | json }},"sku":{{ v.sku | json }},"vendor":{{ product.vendor | json }},"type":{{ product.type | json }},"variant_id":{{ v.id | json }},"single_variant":{{ product.has_only_default_variant | json }},"specs":{{ specs | default: '' | json }}}
